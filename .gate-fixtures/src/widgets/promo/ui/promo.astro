---
// Нарушения канона UI и приложения: CSS UI-кита мимо токен-слоя, env процесса и import.meta.env
// (ключом и деструктуризацией) мимо getRuntimeConfig() и сам getRuntimeConfig() в разметке,
// console мимо log().
import 'fake-ui-kit/kit.css'
import { getRuntimeConfig } from '@/shared/config'
import * as config from '@/shared/config'
import Badge from './badge.astro'

const promo = process.env.PROMO === '1'
const { PUBLIC_PROMO } = import.meta.env
const size = 'text-body'
const label = 'промо'
const WIDTHS = { 'text-body': 'w-[37px]' }
console.log(promo, getRuntimeConfig().RELEASE, config.SITE_NAME, import.meta.env.SECRET_KEY)
---

<!-- Нарушения: сырые <img> и <video> мимо примитивов медиа, client:* без фреймворка островов,
инлайн-style, сырой цвет в классе (литералом и в шаблонной строке), в атрибуте SVG (hex и словом) и в <style> (hex и
словом); значение мимо роли — числовая утилита, произвольный размер и кегль в скобках, ключевое
слово со своим значением (интерлиньяж, скругление, обводка, кольцо, фильтр — и ключом объекта),
переменная ДС в классе, в атрибуте SVG и в <style> (заглавными), размер числом и @apply
произвольного значения в <style>; класс из переменной — в атрибуте, в шаблонной строке, по
ключу карты и вычисляемым ключом; своя color-scheme — утилитой и в <style>; ширина контейнера
мимо примитива секции — утилитой max-w-*, container (ключом объекта) и в <style> (max-width длиной
и @apply); autofocus у поля внутри выражения шаблона; своё знание темы — вариантом класса (dark:,
data-[theme=…]) и в <style> (prefers-color-scheme, data-theme, light-dark() — в трёх блоках);
движение без условия — утилитой (transition-transform), ключом объекта (transition), под
вариантами системы (motion-safe:, motion-reduce:), кривая литералом (ease-linear) и в <style>
(transition, @apply, условие системы, @keyframes с animation — в четырёх блоках). -->
<section class="promo">
  <img src="/promo.png" alt={label} width="10" height="10" />
  <video src="/promo.mp4" width="10" height="10" muted></video>
  <Badge client:load />
  <p style="margin-top: 1rem">{label}</p>
  <p class:list={['mt-md', 'text-[#e11d48]']}>{label}</p>
  <p class={`text-[#e11d48] ${size}`}>{PUBLIC_PROMO}</p>
  <svg viewBox="0 0 1 1" aria-hidden="true"><path fill="#e11d48" d="M0 0h1v1H0z" /></svg>
  <p class:list={['px-6', '-mt-1.5', 'tablet:w-1/2', 'h-px']}>{label}</p>
  <p class="grid-cols-[8rem_1fr] text-[22px]">{label}</p>
  <p class="leading-none rounded-t-full">{label}</p>
  <p class="bg-(--primitive-color-accent-700)">{label}</p>
  <p class={`text-[var(--color-text-primary)] ${size}`}>{label}</p>
  <svg viewBox="0 0 1 1" aria-hidden="true">
    <path fill="var(--primitive-color-red-700)" d="M0 0h1v1H0z" />
  </svg>
  <svg viewBox="0 0 1 1" aria-hidden="true"><path stroke="tomato" d="M0 0h1v1H0z" /></svg>
  <svg viewBox="0 0 2 2" aria-hidden="true">
    <circle cx="1" cy="1" r="1">
      <animate attributeName="r" values="1;0.5;1" dur="1s" repeatCount="indefinite" />
      <animateTransform attributeName="transform" type="rotate" dur="2s" repeatCount="indefinite" />
    </circle>
  </svg>
  <p class="outline inset-ring backdrop-grayscale">{label}</p>
  <p class:list={[{ ring: promo }]}>{label}</p>
  <p class={size}>{label}</p>
  <p class:list={['mt-md', WIDTHS[size], { [size]: promo }]}>{label}</p>
  <p class="scheme-dark">{label}</p>
  <p class="max-w-measure tablet:max-w-container">{label}</p>
  <p class:list={['mt-md', { container: promo }]}>{label}</p>
  {promo && <input type="search" name="q" aria-label={label} autofocus />}
  <p class="dark:hidden">{label}</p>
  <p class="in-data-[theme=dark]:hidden">{label}</p>
  <p class="transition-transform duration-page">{label}</p>
  <p class:list={[{ transition: promo }]}>{label}</p>
  <p class="motion-safe:animate-none hover:motion-safe:transition-all">{label}</p>
  <p class="motion-reduce:hidden">{label}</p>
  <p class="transition-colors ease-linear">{label}</p>
</section>

<style>
  .promo {
    color: #e11d48;
    margin-top: var(--space-md);
    font-size: 22px;
    color-scheme: dark;
    max-width: 40rem;
    transition: transform 0.2s ease-out;
    @apply mt-[13px];
  }

  @media (prefers-color-scheme: dark) {
    .promo {
      display: none;
    }
  }
</style>
<!-- Другим письмом: цвет словом и переменная ДС заглавными. -->
<style>
  .promo {
    border-color: tomato;
    padding: VAR(--space-md);
    @apply max-w-measure;
    @apply hover:animate-spin;
  }

  :global(html[data-theme='dark']) .promo {
    display: none;
  }
</style>
<!-- Третьим письмом: тема функцией light-dark() и условие движения по одной системе. -->
<style>
  .promo {
    fill: light-dark(none, currentColor);
  }

  @media (prefers-reduced-motion: reduce) {
    .promo {
      display: block;
    }
  }
</style>
<!-- Четвёртым письмом: своя анимация мимо слоя. -->
<style>
  @keyframes promo-pulse {
    to {
      opacity: 0;
    }
  }

  .promo {
    animation: promo-pulse 1s infinite;
  }
</style>
