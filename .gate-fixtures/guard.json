{
  "block": [
    "git commit -n -m wip",
    "git commit -nm wip",
    "git commit -an -m wip",
    "git commit --no-verif -m wip",
    "git push --no-verif",
    "git -c core.hooksPath=/dev/null push",
    "git config core.hooksPath .githooks",
    "LEFTHOOK=0 git push",
    "LEFTHOOK=0 git commit -m wip",
    "LEFTHOOK_EXCLUDE=check git push",
    "LEFTHOOK_EXCLUDE=check lefthook run pre-push",
    "LEFTHOOK_BIN=true git push",
    "LEFTHOOK_CONFIG=/dev/null git push",
    "export LEFTHOOK=0 && git push",
    "pnpm exec lefthook uninstall",
    "lefthook uninstall",
    "rm .git/hooks/pre-push",
    "chmod -x .git/hooks/pre-push && git push",
    "printf 'exit 0\\n' > .git/hooks/pre-push",
    "cat > lefthook-local.yml <<'EOF'\npre-push:\n  skip: true\nEOF",
    "cp /tmp/x .git/hooks/pre-commit",
    "sed -i 's/run/true/' .git/hooks/pre-push",
    "perl -pi -e 's/run/true/' .git/hooks/pre-push",
    "git push --force origin main",
    "git push origin main --force-with-lease",
    "git push -f origin main",
    "git push origin +main",
    "git push -uf origin main",
    "cd /tmp && git commit -n",
    "git add -A\ngit commit -n -m wip",
    "git commit \\\n  -n -m wip",
    "bash -c \"LEFTHOOK=0 git push\"",
    "sh -c 'git commit -n -m wip'",
    "bash -lc \"LEFTHOOK=0 git push\"",
    "bash -c -- \"git commit -n -m wip\"",
    "eval \"LEFTHOOK=0 git push\"",
    "bash <<'EOF'\ngit push --no-verif\nEOF",
    "sh -s <<EOF\nLEFTHOOK=0 git push\nEOF"
  ],
  "allow": [
    "git commit -m \"fix: x\"",
    "git commit --amend --no-edit",
    "git commit --no-edit",
    "git commit -F - <<'EOF'\nfeat: x\n\nLEFTHOOK=0, git commit -n и --no-verif в тексте — данные\nEOF",
    "git commit -m \"$(cat <<'EOF'\nfix: x\n\nCo-Authored-By: Claude <noreply@anthropic.com>\nEOF\n)\"",
    "git worktree add --detach ../wt-x HEAD",
    "git -C . worktree remove --force ../wt-x",
    "git restore --staged src/x.ts",
    "git push origin main",
    "git push -u origin feature",
    "git push --follow-tags origin main",
    "git push -n origin main",
    "git tag -a v1.0.0 -m 'v1.0.0'",
    "pnpm exec lefthook install",
    "LEFTHOOK_VERBOSE=1 lefthook run pre-push",
    "cat .git/hooks/pre-push",
    "sed -n '1,20p' .git/hooks/pre-push",
    "sed -i 's/a/b/' src/x.ts",
    "grep -rn \"core.hooksPath\" docs",
    "git log --oneline -n 5",
    "git stash push -m wip",
    "echo \"git commit -n\" > notes.txt",
    "pnpm install --frozen-lockfile --prefer-offline",
    "git grep -n \"LEFTHOOK=0\"",
    "git commit -m \"fix: x\n\nLEFTHOOK=0 и core-флаги в тексте — данные\"",
    "bash -c \"echo ok\"",
    "bash -c 'pnpm -s lint'",
    "bash -lc \"pnpm -s check\"",
    "bash <<'EOF'\npnpm -s lint\nEOF",
    "eval \"$(fnm env)\""
  ]
}
