{
  "name": "spike-sveltekit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev --port 3203 --host",
    "build": "vite build",
    "preview": "vite preview --port 3203",
    "start": "node build",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "lint": "eslint .",
    "format:check": "biome check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "steiger": "steiger src",
    "size": "size-limit",
    "gen:covers": "node scripts/gen-covers.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm steiger && pnpm build && pnpm size",
    "gen:og": "node scripts/gen-og.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "@biomejs/biome",
      "@tailwindcss/oxide",
      "workerd"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.13",
    "@eslint/js": "^9.39.5",
    "@feature-sliced/steiger-plugin": "0.7.0",
    "@fontsource-variable/inter": "5.3.0",
    "@inlang/paraglide-js": "2.25.2",
    "@playwright/test": "1.63.0",
    "@size-limit/file": "13.1.1",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/enhanced-img": "0.11.0",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "5.4.2",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "^17.12.0",
    "gray-matter": "4.0.3",
    "happy-dom": "^20.14.5",
    "lru-cache": "11.5.2",
    "mdsvex": "0.12.8",
    "sharp": "0.35.4",
    "size-limit": "13.1.1",
    "steiger": "0.6.0",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "vitest-axe": "^0.1.0",
    "zod": "4.6.5"
  }
}
