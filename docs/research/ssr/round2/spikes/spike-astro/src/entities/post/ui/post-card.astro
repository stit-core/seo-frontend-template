---
import { Image } from 'astro:assets'
import type { Locale } from '@/shared/i18n'
import { localePath } from '@/shared/seo'
import type { Post } from '../api/queries'

interface Props {
  post: Post
  locale: Locale
  eager?: boolean
}

const { post, locale, eager = false } = Astro.props
const href = localePath(locale, `/blog/${post.id}`)
const formatter = new Intl.DateTimeFormat(locale === 'ru' ? 'ru-RU' : 'en-GB', {
  dateStyle: 'long',
})
---
<article class="border-b border-divider pb-6">
  <a href={href} class="block no-underline">
    <Image
      src={post.data.cover}
      alt={post.data.title}
      widths={[320, 640, 960]}
      sizes="(min-width: 768px) 700px, 100vw"
      format="webp"
      loading={eager ? 'eager' : 'lazy'}
      {...(eager ? { fetchpriority: 'high' as const } : {})}
      class="w-full rounded-control"
    />
    <h3 class="mt-4 text-heading-sm font-semibold text-ink">{post.data.title}</h3>
  </a>
  <p class="mt-2 text-body-md text-muted">{post.data.description}</p>
  <p class="mt-2 text-body-sm text-muted">
    <time datetime={post.data.pubDate.toISOString()}>{formatter.format(post.data.pubDate)}</time>
  </p>
</article>
