---
import { type Locale, t } from '@/shared/i18n'
import { localePath, stripLocale } from '@/shared/seo'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const current = stripLocale(Astro.url.pathname)
const links = [
  { href: localePath(locale, '/'), label: t(locale, 'nav.home') },
  { href: localePath(locale, '/blog'), label: t(locale, 'nav.blog') },
  { href: localePath(locale, '/about'), label: t(locale, 'nav.about') },
  { href: localePath(locale, '/contact'), label: t(locale, 'nav.contact') },
]
const other: Locale = locale === 'ru' ? 'en' : 'ru'
---
<header class="border-b border-divider bg-surface">
  <nav class="mx-auto flex max-w-3xl items-center gap-4 px-6 py-4 text-body-sm" aria-label="main">
    <a href={localePath(locale, '/')} class="font-semibold text-ink no-underline">stit demo</a>
    <ul class="flex flex-1 gap-4 list-none p-0 m-0">
      {links.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
    <a href={localePath(other, current)} hreflang={other} rel="alternate">{other.toUpperCase()}</a>
  </nav>
</header>
