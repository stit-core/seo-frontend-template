---
import type { Locale } from '@/shared/i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const year = new Date().getFullYear()
---
<footer class="border-t border-divider bg-surface">
  <div class="mx-auto max-w-3xl px-6 py-6 text-body-sm text-muted">
    <p>© {year} stit demo · {locale === 'ru' ? 'демо контентного сайта' : 'content site demo'}</p>
    <p><a href="/rss.xml">RSS</a> · <a href="/sitemap-index.xml">sitemap</a></p>
  </div>
</footer>
