---
import { type Post, PostCard } from '@/entities/post'
import type { Locale } from '@/shared/i18n'

interface Props {
  posts: Post[]
  locale: Locale
}

const { posts, locale } = Astro.props
---
<div class="flex flex-col gap-8">
  {posts.map((post, index) => <PostCard post={post} locale={locale} eager={index === 0} />)}
</div>
