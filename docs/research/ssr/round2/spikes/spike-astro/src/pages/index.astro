---
import DocumentLayout from '@/app/layouts/document.astro'
import { latestPosts } from '@/entities/post'
import { t } from '@/shared/i18n'
import { countRender } from '@/shared/lib'
import { JsonLdScript, organization, SeoHead, website } from '@/shared/seo'
import { Hero } from '@/widgets/hero'
import { PostList } from '@/widgets/post-list'

const locale = 'ru' as const
const posts = await latestPosts(3)
const renders = countRender('/')
// Спайк: искусственная «дорогая» страница — проверка дедупликации промахов.
const delayMs = Number(process.env.SPIKE_RENDER_DELAY_MS ?? 0)
if (delayMs > 0) await new Promise((resolve) => setTimeout(resolve, delayMs))
---
<DocumentLayout locale={locale}>
  <Fragment slot="head">
    <SeoHead
      title={t(locale, 'home.title')}
      description={t(locale, 'home.description')}
      path="/"
      pathWithoutLocale="/"
      locale={locale}
    />
    <JsonLdScript data={[organization(), website()]} />
  </Fragment>
  <Hero locale={locale} />
  <p hidden data-renders={renders}></p>
  <h2 class="text-heading-md font-semibold text-ink">{t(locale, 'home.latest')}</h2>
  <div class="mt-6"><PostList posts={posts} locale={locale} /></div>
</DocumentLayout>
