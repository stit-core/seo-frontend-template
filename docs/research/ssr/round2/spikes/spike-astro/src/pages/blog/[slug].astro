---
import { Picture } from 'astro:assets'
import { render } from 'astro:content'
import type { GetStaticPaths } from 'astro'
import DocumentLayout from '@/app/layouts/document.astro'
import { getPost, lastmod, listPosts, type Post } from '@/entities/post'
import { t } from '@/shared/i18n'
import { article, breadcrumbs, JsonLdScript, SeoHead } from '@/shared/seo'

export const getStaticPaths = (async () => {
  const posts = await listPosts()
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}) satisfies GetStaticPaths

const locale = 'ru' as const
// В on-demand режиме getStaticPaths не вызывается — берём пост по параметру.
const post: Post | undefined =
  (Astro.props as { post?: Post }).post ?? (await getPost(Astro.params.slug ?? ''))
if (!post) return new Response(null, { status: 404 })
const { Content } = await render(post)
const path = `/blog/${post.id}`
const formatter = new Intl.DateTimeFormat('ru-RU', { dateStyle: 'long' })
---
<DocumentLayout locale={locale}>
  <Fragment slot="head">
    <SeoHead
      title={post.data.title}
      description={post.data.description}
      path={path}
      pathWithoutLocale={path}
      locale={locale}
      ogType="article"
      ogImage={post.data.cover.src}
    />
    <JsonLdScript
      data={[
        article({
          path,
          title: post.data.title,
          description: post.data.description,
          image: post.data.cover.src,
          published: post.data.pubDate,
          updated: post.data.updatedDate,
        }),
        breadcrumbs([
          { name: t(locale, 'breadcrumbs.home'), path: '/' },
          { name: t(locale, 'blog.title'), path: '/blog' },
          { name: post.data.title, path },
        ]),
      ]}
    />
  </Fragment>

  <nav aria-label="breadcrumbs" class="text-body-sm text-muted">
    <a href="/">{t(locale, 'breadcrumbs.home')}</a> / <a href="/blog">{t(locale, 'blog.title')}</a>
  </nav>

  <h1 class="mt-4 text-heading-lg font-semibold text-ink">{post.data.title}</h1>
  <p class="mt-2 text-body-sm text-muted">
    {t(locale, 'post.published')}
    <time datetime={post.data.pubDate.toISOString()}>{formatter.format(post.data.pubDate)}</time>
    {post.data.updatedDate && (
      <>
        · {t(locale, 'post.updated')}
        <time datetime={lastmod(post).toISOString()}>{formatter.format(lastmod(post))}</time>
      </>
    )}
  </p>

  <Picture
    src={post.data.cover}
    alt={post.data.title}
    formats={['avif', 'webp']}
    fallbackFormat="jpeg"
    widths={[480, 800, 1200]}
    sizes="(min-width: 768px) 700px, 100vw"
    loading="eager"
    fetchpriority="high"
    class="mt-6 w-full rounded-control"
  />

  <div class="prose mt-8 flex flex-col gap-4 text-body-md"><Content /></div>
</DocumentLayout>
