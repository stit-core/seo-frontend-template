---
import type { Author } from '@/entities/author'
import { Hero } from '@/widgets/hero'
import { cn } from '@/shared/lib'
const { title } = Astro.props as { title: string }
const author: Author = { slug: 'a', name: 'A' }
---

<article class={cn('post-card')}>
  <h2>{title}</h2>
  <p>{author.name}</p>
  <Hero />
</article>
