---
import { getCollection } from 'astro:content'
const posts = await getCollection('post')
const { lang = 'ru' } = Astro.props
---

<section class="grid">
  {posts.map((p) => (
    <article>
      <a href={`/${lang}/blog/${p.id}/`}>{p.data.title}</a>
      <img src={p.data.cover.src} width={800} height={450} />
      <p set:html={p.data.description} />
    </article>
  ))}
  {posts.length === 0 && <p>Нет постов</p>}
</section>

<script>
  document.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => {}))
</script>
