# Runtime env Node-процесса: в контейнере — env сервиса, локально этот файл как .env
# читает `pnpm start` (node --env-file-if-exists=.env). Ничего из этого не попадает в
# сборку: prerender собирается с плейсхолдером origin, который entrypoint штампует при старте.
# Пустое значение равносильно незаданному — берётся дефолт.

# Канонический origin (абсолютный http(s)-URL без хвостового слеша). Обязателен в
# рантайме; с плейсхолдером https://__site_origin__ (значение сборки) сервер не стартует.
SITE_URL=http://localhost:3000

# index | noindex — staging: X-Robots-Tag на on-demand ответах и robots.txt = Disallow: /.
ROBOTS_POLICY=index

# Ключ IndexNow (8–128 символов a-z, A-Z, 0-9, дефис): подтверждается файлом /<ключ>.txt;
# пусто — файла нет.
INDEXNOW_KEY=

# allow | deny — запрет обучающих AI-краулеров (GPTBot, ClaudeBot, Google-Extended, …) в robots.txt.
AI_TRAINING=allow

# Версия для логов; в проде — тег образа.
RELEASE=unknown

# debug | info | warn | error — уровень JSON-лога запросов.
LOG_LEVEL=info

# Процесс: слушатель и таймауты обёртки сервера.
HOST=0.0.0.0
PORT=3000
KEEP_ALIVE_TIMEOUT_MS=65000
SHUTDOWN_TIMEOUT_MS=15000
