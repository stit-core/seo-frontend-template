# Режим API: mock | real
# - mock: MSW перехватывает /api/* на сетевом уровне (бэкенд не нужен)
# - real: Vite proxy форвардит /api → VITE_API_TARGET
VITE_API_MODE=mock

# Хост бэкенда для VITE_API_MODE=real (dev). В проде не используется (там nginx).
VITE_API_TARGET=http://localhost:8080

# Сценарий mock-данных при старте: empty | populated | authenticated | error
VITE_MOCK_SCENARIO=populated

# Включить dev-UI mock-переключателя сценариев
VITE_MOCK_DEVTOOLS=1
