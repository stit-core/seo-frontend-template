{
  "name": "@stit/spa-frontend-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && eslint .",
    "lint:fix": "biome check --write . && eslint --fix .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "steiger": "steiger src",
    "size": "size-limit",
    "gen": "tsr generate",
    "gen:msw": "msw init public/ --save",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm steiger && pnpm build && pnpm size",
    "analyze": "vite build --mode analyze",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@lingui/core": "^5.2.0",
    "@lingui/react": "^5.2.0",
    "@tanstack/react-form": "^1.0.0",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-router": "^1.95.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@biomejs/biome": "^2.0.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.0.0",
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@mswjs/data": "^0.16.0",
    "@playwright/test": "^1.49.0",
    "@sentry/react": "^8.50.0",
    "@size-limit/file": "^11.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-query-devtools": "^5.62.0",
    "@tanstack/react-router-devtools": "^1.95.0",
    "@tanstack/router-cli": "^1.167.0",
    "@tanstack/router-plugin": "^1.168.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "axe-core": "^4.10.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.20.0",
    "eslint-plugin-boundaries": "^5.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-testing-library": "^7.0.0",
    "globals": "^15.14.0",
    "happy-dom": "^16.0.0",
    "lefthook": "^1.10.0",
    "msw": "^2.14.0",
    "playwright": "^1.49.0",
    "size-limit": "^11.0.0",
    "steiger": "^0.6.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^8.0.0",
    "vite-bundle-analyzer": "^0.18.0",
    "vitest": "^4.0.0",
    "vitest-axe": "^0.1.0",
    "web-vitals": "^4.2.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
