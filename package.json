{
  "name": "@stit/ssr-frontend-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node --env-file-if-exists=.env ./docker/server.mjs",
    "typecheck": "astro check",
    "lint": "biome check . && eslint .",
    "lint:fix": "biome check --write . && eslint --fix .",
    "format": "biome format --write . && prettier --write \"src/**/*.astro\"",
    "format:check": "biome format . && prettier --check \"src/**/*.astro\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "steiger": "steiger src",
    "check:gate": "node scripts/check-gate.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:links": "node scripts/check-links.mjs",
    "seo:check": "node scripts/seo-check.mjs",
    "size": "size-limit",
    "kin:diff": "node scripts/kin-diff.mjs",
    "ttfb": "node scripts/ttfb.mjs",
    "accept:image": "sh scripts/accept-image.sh",
    "plan:check": "bash scripts/validate-plan.sh",
    "check": "pnpm plan:check && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm steiger && pnpm check:gate && pnpm check:content && pnpm build && pnpm check:links && pnpm seo:check && pnpm size",
    "prepare": "lefthook install"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "@biomejs/biome",
      "lefthook"
    ]
  },
  "dependencies": {
    "@astrojs/node": "11.1.6",
    "@astrojs/rss": "4.0.19",
    "@sentry/node": "10.75.0",
    "astro": "7.3.3",
    "nodemailer": "10.0.10",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@feature-sliced/steiger-plugin": "0.7.0",
    "@playwright/test": "1.63.0",
    "@size-limit/file": "14.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.13.5",
    "@vitest/coverage-v8": "5.0.1",
    "astro-eslint-parser": "3.1.0",
    "axe-core": "4.13.0",
    "eslint": "10.10.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "17.12.0",
    "happy-dom": "20.14.5",
    "js-yaml": "4.3.2",
    "lefthook": "2.1.14",
    "prettier": "3.9.7",
    "prettier-plugin-astro": "1.0.1",
    "size-limit": "14.0.0",
    "steiger": "0.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
