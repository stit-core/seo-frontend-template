---
import type { ImageMetadata } from 'astro'
import { MOTION } from './conditions'

// Ролик-петля — фон, смысл несёт текст рядом. Источники встают только при разрешённом движении: при
// системном сокращённом движении браузер не выбирает ни одного и не качает ни байта — без скрипта, на месте
// ролика остаётся постер. Выбор посетителя («меньше» — пауза и обрыв загрузки, «полное» вопреки системе —
// источники без условия движения) исполняет остров предпочтений.
// Автозапуск сильнее `preload="none"`: запущенная петля качается целиком; без автозапуска ролик ждёт, не
// качаясь. Ниже первого экрана петля ленивая: браузер запускает её у экрана (браузер без ленивой загрузки
// видео — с загрузки страницы). Петля первого экрана стартует сразу, а её постер, кандидат в LCP, грузится
// с приоритетом: у постера нет своего `fetchpriority` — его даёт preload.
// Ролик один на любое окно: место под ним резервирует постер — один адрес на все окна, — и ролик другой
// пропорции на телефоне сдвинул бы вёрстку, когда придут его данные.
interface Source {
  src: string
  // MIME с кодеком (`video/mp4; codecs="av01.0.08M.10"`): ролик, который браузер не сыграет, он пропускает.
  type: string
}

interface Props {
  // Кадр 0 ролика: виден до загрузки и при сокращённом движении; размеры ролика — его.
  poster: ImageMetadata
  // Ролик в разных кодеках: AV1 первым, H.264 — всегда.
  sources: readonly Source[]
  // Роль слота — первый экран: петля стартует сразу, постер — с приоритетом; без неё — лениво.
  lcp?: boolean | undefined
  class?: string | undefined
}

const { poster, sources, lcp = false, class: className } = Astro.props
---

{lcp && <link rel="preload" as="image" href={poster.src} fetchpriority="high" />}
<video
  autoplay
  muted
  loop
  playsinline
  preload="none"
  loading={lcp ? undefined : 'lazy'}
  poster={poster.src}
  width={poster.width}
  height={poster.height}
  aria-hidden="true"
  class={className}
>
  {sources.map(({ src, type }) => (
    <source media={MOTION} src={src} type={type} />
  ))}
</video>
