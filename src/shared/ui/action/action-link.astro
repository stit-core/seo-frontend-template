---
interface Props {
  href: string
  // Язык цели, когда это версия страницы на другом языке: на языке страницы версии нет.
  hreflang?: string | undefined
  label: string
  // Главный призыв — кнопка с заливкой акцентом, второй путь — ссылкой: иной стиль у того же ряда (каталог strategy).
  kind: 'primary' | 'secondary'
}

const { href, hreflang, label, kind } = Astro.props
---

<a
  href={href}
  hreflang={hreflang}
  class:list={{ button: kind === 'primary', 'touch-target': kind === 'secondary' }}
>
  {label}
</a>
