---
interface Props {
  // Колонка чтения, страница (шапка и подвал), широкая сетка; `full` — всё окно: ни границы, ни
  // полей страницы.
  width?: 'reading' | 'page' | 'wide' | 'full' | undefined
  class?: string | undefined
}

const { width = 'reading', class: className } = Astro.props
---

<div
  class:list={[
    {
      'mx-auto w-full px-page-x': width !== 'full',
      'max-w-measure': width === 'reading',
      'max-w-container': width === 'page',
      'max-w-container-wide': width === 'wide',
    },
    className,
  ]}
>
  <slot />
</div>
