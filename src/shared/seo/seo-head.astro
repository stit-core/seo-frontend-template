---
import { AI_BOTS_POLICY, SITE_NAME, SITE_VERIFICATION } from '@/shared/config'
import { isoDate, type Locale, localePath, t } from '@/shared/i18n'
import { aiBotsMeta } from './ai-bots'
import { defaultOgImage, OG_LOCALE, type OgImage, pageTitle } from './meta'
import { absoluteUrl, alternates } from './urls'

interface Props {
  title: string
  description: string
  locale: Locale
  // Путь перевода без префикса локали; без него hreflang не выводится.
  alternatePath?: string | undefined
  // Служебная или тонкая страница (404, /now, тег ниже порога): только noindex — без canonical,
  // OG и hreflang.
  noindex?: boolean | undefined
  ogType?: 'website' | 'article' | undefined
  ogImage?: OgImage | undefined
  // Даты записи для article:*; только при ogType="article".
  article?: { published: Date; modified?: Date | undefined } | undefined
}

const {
  title,
  description,
  locale,
  alternatePath,
  noindex = false,
  ogType = 'website',
  ogImage = defaultOgImage(locale),
  article,
} = Astro.props

const fullTitle = pageTitle(title)
// Origin — runtime SITE_URL на on-demand; на prerender — плейсхолдер сборки, его штампует entrypoint.
const path = Astro.url.pathname
const canonical = absoluteUrl(path)
const links = alternates({ locale, path, alternatePath })
const otherLocale = links.find((link) => link.hreflang !== locale && link.hreflang !== 'x-default')
const feedTitle = `${t(locale, 'blog.title')} — ${SITE_NAME}`
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}
{!noindex && (
  <Fragment>
    <link rel="canonical" href={canonical} />
    {links.map((link) => (
      <link rel="alternate" hreflang={link.hreflang} href={link.href} />
    ))}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {otherLocale && (
      <meta property="og:locale:alternate" content={OG_LOCALE[otherLocale.hreflang as Locale]} />
    )}
    <meta property="og:image" content={absoluteUrl(ogImage.path)} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta property="og:image:alt" content={ogImage.alt} />
    {article && <meta property="article:published_time" content={isoDate(article.published)} />}
    {article?.modified && (
      <meta property="article:modified_time" content={isoDate(article.modified)} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    {SITE_VERIFICATION.google !== '' && (
      <meta name="google-site-verification" content={SITE_VERIFICATION.google} />
    )}
    {SITE_VERIFICATION.yandex !== '' && (
      <meta name="yandex-verification" content={SITE_VERIFICATION.yandex} />
    )}
    {aiBotsMeta(AI_BOTS_POLICY).map((meta) => (
      <meta name={meta.name} content={meta.content} />
    ))}
  </Fragment>
)}
<link
  rel="alternate"
  type="application/rss+xml"
  title={feedTitle}
  href={absoluteUrl(localePath(locale, '/rss.xml'))}
/>
