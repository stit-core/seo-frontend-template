---
import { AI_BOTS_POLICY, SITE_NAME, SITE_VERIFICATION } from '@/shared/config'
import { isoDate, type Locale, localeInfo, type Translations, t } from '@/shared/i18n'
import { aiBotsMeta } from './ai-bots'
import { defaultOgImage, type OgImage, type PageMeta } from './meta'
import { absoluteUrl, alternates } from './urls'

interface Props {
  meta: PageMeta
  locale: Locale
  // Карта переводов страницы (своя версия — тоже); без второй версии hreflang не выводится.
  translations?: Translations | undefined
  // Фид блога языка страницы для автообнаружения; у языка без блога его нет.
  feed?: string | undefined
  // Служебная или тонкая страница (404, ответ формы, тег ниже порога): только noindex — без canonical,
  // OG и hreflang.
  noindex?: boolean | undefined
  ogImage?: OgImage | undefined
  // Даты записи коллекции: её страница — статья (og:type article и article:*), остальные — website.
  article?: { published: Date; modified?: Date | undefined } | undefined
}

const {
  meta,
  locale,
  translations = {},
  feed,
  noindex = false,
  ogImage = defaultOgImage(locale),
  article,
} = Astro.props

// Origin — runtime SITE_URL на on-demand; на prerender — плейсхолдер сборки, его штампует entrypoint.
const path = Astro.url.pathname
const canonical = absoluteUrl(path)
const links = alternates(translations)
const others = links.flatMap((link) =>
  link.hreflang === 'x-default' || link.hreflang === locale ? [] : [localeInfo(link.hreflang).og],
)
---

<title>{meta.title}</title>
<meta name="description" content={meta.description} />
{noindex && <meta name="robots" content="noindex" />}
{!noindex && (
  <Fragment>
    <link rel="canonical" href={canonical} />
    {links.map((link) => (
      <link rel="alternate" hreflang={link.hreflang} href={link.href} />
    ))}
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={meta.ogTitle ?? meta.title} />
    <meta property="og:description" content={meta.ogDescription ?? meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={localeInfo(locale).og} />
    {others.map((og) => (
      <meta property="og:locale:alternate" content={og} />
    ))}
    <meta property="og:image" content={absoluteUrl(ogImage.path)} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta property="og:image:alt" content={ogImage.alt} />
    {article && <meta property="article:published_time" content={isoDate(article.published)} />}
    {article?.modified && (
      <meta property="article:modified_time" content={isoDate(article.modified)} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    {SITE_VERIFICATION.google !== '' && (
      <meta name="google-site-verification" content={SITE_VERIFICATION.google} />
    )}
    {SITE_VERIFICATION.yandex !== '' && (
      <meta name="yandex-verification" content={SITE_VERIFICATION.yandex} />
    )}
    {aiBotsMeta(AI_BOTS_POLICY).map((meta) => (
      <meta name={meta.name} content={meta.content} />
    ))}
  </Fragment>
)}
{feed !== undefined && (
  <link
    rel="alternate"
    type="application/rss+xml"
    title={t(locale, 'blog.feed', { site: SITE_NAME })}
    href={absoluteUrl(feed)}
  />
)}
