---
import { type Locale, t } from '@/shared/i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
// Подпись называет то, что объявляет `aria-pressed`: тёмная тема — включена или нет.
const label = t(locale, 'theme.dark')
---

{/* Кнопка видна, когда остров предпочтений объявил её состояние: без него выбор не применить и
не сохранить. Иконка показывает результат нажатия: в светлой теме — луна, в тёмной — солнце. */}
<button
  type="button"
  data-theme-toggle
  aria-label={label}
  title={label}
  class="group touch-target -mr-xs hidden size-2xl items-center justify-center rounded-control text-secondary hover:text-primary aria-[pressed]:inline-flex"
>
  <svg
    class="size-icon-md group-aria-pressed:hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20 14.6A8.6 8.6 0 0 1 9.4 4 8.6 8.6 0 1 0 20 14.6Z"></path>
  </svg>
  <svg
    class="hidden size-icon-md group-aria-pressed:block"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4.2"></circle>
    <path d="M12 2.6v2.2M12 19.2v2.2M4.2 12H2M22 12h-2.2M5.6 5.6l1.6 1.6M16.8 16.8l1.6 1.6M18.4 5.6l-1.6 1.6M7.2 16.8l-1.6 1.6"></path>
  </svg>
</button>
