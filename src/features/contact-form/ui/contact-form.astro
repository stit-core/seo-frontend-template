---
import { type DictKey, type Locale, t } from '@/shared/i18n'
import {
  type ContactErrors,
  type ContactValues,
  EMPTY_CONTACT_VALUES,
  HONEYPOT_FIELD,
  LOCALE_FIELD,
  MESSAGE_LENGTH,
  NAME_LENGTH,
} from '../model/schema'

interface Props {
  locale: Locale
  // Маршрут обработчика знает страница: слайс не решает, как устроен роутинг.
  action: string
  // Значения и ошибки приходят от обработчика формы; на самой странице контактов их нет.
  values?: ContactValues | undefined
  errors?: ContactErrors | undefined
  notice?: DictKey | undefined
  policyHref: string
}

const {
  locale,
  action,
  values = EMPTY_CONTACT_VALUES,
  errors = {},
  notice,
  policyHref,
} = Astro.props

const failures = [
  { field: 'name', id: 'contact-name', key: errors.name },
  { field: 'email', id: 'contact-email', key: errors.email },
  { field: 'message', id: 'contact-message', key: errors.message },
  { field: 'consent', id: 'contact-consent', key: errors.consent },
].filter((item): item is { field: string; id: string; key: DictKey } => item.key !== undefined)

const describedBy = (id: string, failed: boolean): string | undefined =>
  failed ? `${id}-error` : undefined
---

{/* Сводка получает фокус при загрузке ответа, без JS: чтец экрана и клавиатура начинают с
отказа, а не с начала страницы; `role="alert"` при загрузке объявляют не все чтецы. */}
{(failures.length > 0 || notice) && (
  <div
    role="alert"
    aria-labelledby="contact-summary-title"
    tabindex="-1"
    autofocus
    class="mb-lg rounded-control border-l-thick border-danger bg-danger px-md py-sm text-body"
  >
    <h3 id="contact-summary-title" class="text-body-strong">
      {t(locale, 'form.summary')}
    </h3>
    {notice && <p class="mt-xs">{t(locale, notice)}</p>}
    {failures.length > 0 && (
      <ul class="mt-xs list-disc space-y-2xs pl-lg text-helper">
        {failures.map((failure) => (
          <li>
            <a class="touch-target" href={`#${failure.id}`}>
              {t(locale, failure.key)}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
)}

<form method="post" action={action} class="grid gap-lg">
  <input type="hidden" name={LOCALE_FIELD} value={locale} />

  <div>
    <label class="block text-label" for="contact-name">
      {t(locale, 'form.name')}
    </label>
    <input
      class="field mt-xs"
      id="contact-name"
      name="name"
      type="text"
      value={values.name}
      required
      minlength={NAME_LENGTH.min}
      maxlength={NAME_LENGTH.max}
      autocomplete="name"
      aria-invalid={errors.name ? 'true' : undefined}
      aria-describedby={describedBy('contact-name', errors.name !== undefined)}
    />
    {errors.name && (
      <p class="mt-xs text-helper text-danger" id="contact-name-error">
        {t(locale, errors.name)}
      </p>
    )}
  </div>

  <div>
    <label class="block text-label" for="contact-email">
      {t(locale, 'form.email')}
    </label>
    <input
      class="field mt-xs"
      id="contact-email"
      name="email"
      type="email"
      value={values.email}
      required
      maxlength={254}
      autocomplete="email"
      aria-invalid={errors.email ? 'true' : undefined}
      aria-describedby={describedBy('contact-email', errors.email !== undefined)}
    />
    {errors.email && (
      <p class="mt-xs text-helper text-danger" id="contact-email-error">
        {t(locale, errors.email)}
      </p>
    )}
  </div>

  <div>
    <label class="block text-label" for="contact-message">
      {t(locale, 'form.message')}
    </label>
    <textarea
      class="field mt-xs resize-y"
      id="contact-message"
      name="message"
      rows="6"
      required
      minlength={MESSAGE_LENGTH.min}
      maxlength={MESSAGE_LENGTH.max}
      aria-invalid={errors.message ? 'true' : undefined}
      aria-describedby={describedBy('contact-message', errors.message !== undefined)}
    >{values.message}</textarea>
    {errors.message && (
      <p class="mt-xs text-helper text-danger" id="contact-message-error">
        {t(locale, errors.message)}
      </p>
    )}
  </div>

  <div class="honeypot" aria-hidden="true">
    <label for="contact-company">{t(locale, 'form.honeypot')}</label>
    <input
      id="contact-company"
      name={HONEYPOT_FIELD}
      type="text"
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  <div class="note">
    <label class="flex items-start gap-sm" for="contact-consent">
      <input
        class="touch-target size-md shrink-0 pointer-fine:mt-3xs"
        id="contact-consent"
        name="consent"
        type="checkbox"
        value="1"
        required
        checked={values.consent}
        aria-invalid={errors.consent ? 'true' : undefined}
        aria-describedby={describedBy('contact-consent', errors.consent !== undefined)}
      />
      <span>
        {t(locale, 'form.consent')} — <a href={policyHref}>{t(locale, 'form.consentPolicy')}</a>
      </span>
    </label>
    {errors.consent && (
      <p class="mt-xs text-helper text-danger" id="contact-consent-error">
        {t(locale, errors.consent)}
      </p>
    )}
  </div>

  <div>
    <button class="button" type="submit">
      {t(locale, 'form.submit')}
    </button>
  </div>
</form>

<style>
  /* Ловушка для ботов: человек её не видит и не встретит с клавиатуры. */
  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
