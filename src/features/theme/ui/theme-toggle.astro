---
import { type Locale, t } from '@/shared/i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const label = t(locale, 'theme.toggle')
---

<button
  type="button"
  data-theme-toggle
  aria-label={label}
  title={label}
  class="theme-toggle -mr-2 h-10 w-10 items-center justify-center rounded-control text-secondary hover:text-primary"
>
  <svg
    class="icon-to-dark"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20 14.6A8.6 8.6 0 0 1 9.4 4 8.6 8.6 0 1 0 20 14.6Z"></path>
  </svg>
  <svg
    class="icon-to-light"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4.2"></circle>
    <path d="M12 2.6v2.2M12 19.2v2.2M4.2 12H2M22 12h-2.2M5.6 5.6l1.6 1.6M16.8 16.8l1.6 1.6M18.4 5.6l-1.6 1.6M7.2 16.8l-1.6 1.6"></path>
  </svg>
</button>

<style>
  /* Кнопка появляется, только когда остров темы запустился: без JS выбор негде сохранить. */
  .theme-toggle {
    display: none;
  }

  :global(html[data-js='on']) .theme-toggle {
    display: inline-flex;
  }

  /* Иконка показывает результат нажатия: в светлой теме — луна, в тёмной — солнце. */
  .icon-to-light {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme='light'])) .icon-to-dark {
      display: none;
    }

    :global(html:not([data-theme='light'])) .icon-to-light {
      display: block;
    }
  }

  :global(html[data-theme='dark']) .icon-to-dark {
    display: none;
  }

  :global(html[data-theme='dark']) .icon-to-light {
    display: block;
  }
</style>
