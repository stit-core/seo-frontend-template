---
// Остров темы целиком: ставит выбор атрибутом ДС `data-theme` до первой отрисовки и обслуживает
// переключатель делегированием — скрипт живёт в <head>. Выбор хранит cookie `scheme` (техническая,
// согласия не требует); без выбора тему даёт файл токенов. `data-js` на <html> — признак для CSS:
// без скрипта переключатель бесполезен. Тело уезжает в <head> каждой страницы как есть: плотное,
// без комментариев и прагм, мимо форматтера; хеш тела — строка ISLANDS политики сборки.
---

<script is:inline data-island="theme">{const d=document,s=d.documentElement.dataset,m=/(^|; )scheme=(light|dark)/.exec(d.cookie)
if(m)s.theme=m[2]
s.js='on'
d.addEventListener('click',e=>{if(e.target.closest?.('[data-theme-toggle]')){s.theme=(s.theme?s.theme==='dark':matchMedia('(prefers-color-scheme:dark)').matches)?'light':'dark'
d.cookie=`scheme=${s.theme};path=/;max-age=31536000;samesite=lax${location.protocol==='https:'?';secure':''}`}})}</script>
