---
import { Picture } from 'astro:assets'
import { formatDate, isoDate } from '@/shared/i18n'
import { Heading } from '@/shared/ui/heading'
import type { Post } from '../api/queries'
import { postPath } from '../lib/paths'
import DraftBadge from './draft-badge.astro'
import TagList from './tag-list.astro'

interface Props {
  post: Post
}

const { post } = Astro.props
const { locale, slug, data } = post
// Миниатюра дублирует заголовок-ссылку, поэтому для чтеца она пустая; грузится лениво.
const cover = data.cover && data.coverAlt ? data.cover : undefined
---

<article class="flex items-start justify-between gap-lg border-b border-subtle pb-xl">
  <div class="min-w-0">
    <Heading level={2} kind="card">
      <a
        href={postPath(locale, slug)}
        class="touch-target text-primary no-underline hover:text-accent"
      >
        {data.title}
      </a>
    </Heading>
    <p class="mt-xs flex flex-wrap items-center gap-x-xs text-helper text-secondary">
      {data.draft && <DraftBadge locale={locale} />}
      <time datetime={isoDate(data.pubDate)}>{formatDate(locale, data.pubDate)}</time>
    </p>
    <p class="mt-sm text-body">{data.description}</p>
    <TagList locale={locale} tags={data.tags} class="mt-sm" />
  </div>
  {cover && (
    // Слот миниатюры постоянной ширины: файл — по плотности экрана, а не по ширине окна.
    <div class="hidden w-thumbnail shrink-0 tablet:block">
      <Picture
        src={cover}
        alt=""
        width={160}
        height={90}
        densities={[2]}
        formats={['avif']}
        fallbackFormat="webp"
        loading="lazy"
        decoding="async"
        class="rounded-control border border-subtle"
      />
    </div>
  )}
</article>
