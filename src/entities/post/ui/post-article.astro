---
import { Picture } from 'astro:assets'
import { formatDate, isoDate, t } from '@/shared/i18n'
import { Heading } from '@/shared/ui/heading'
import type { Post } from '../api/queries'
import DraftBadge from './draft-badge.astro'
import TagList from './tag-list.astro'

interface Props {
  post: Post
  // id заголовка записи: им страница подписывает свою секцию.
  titleId?: string | undefined
}

const { post, titleId } = Astro.props
const { locale, data } = post
// Обложка — LCP-элемент записи: грузится сразу и с приоритетом, размеры заданы.
const cover = data.cover && data.coverAlt ? { src: data.cover, alt: data.coverAlt } : undefined
---

<article>
  {cover && (
    <Picture
      src={cover.src}
      alt={cover.alt}
      widths={[480, 800, 1200]}
      sizes="(min-width: 40rem) 40rem, 100vw"
      formats={['avif', 'webp']}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="mb-xl rounded-panel border border-subtle"
    />
  )}
  <header class="border-b border-subtle pb-lg">
    <Heading level={1} id={titleId}>
      {data.title}
    </Heading>
    <p class="mt-stack-display text-lead text-secondary">{data.description}</p>
    {/* Подпись автора ставит страница: реестр авторов — соседний слайс. */}
    <slot name="byline" />
    <p class="mt-md flex flex-wrap items-center gap-x-xs text-helper text-secondary">
      {data.draft && <DraftBadge locale={locale} />}
      <span>
        {t(locale, 'post.published')}{' '}
        <time datetime={isoDate(data.pubDate)}>{formatDate(locale, data.pubDate)}</time>
      </span>
      {data.updatedDate && (
        <span>
          · {t(locale, 'post.updated')}{' '}
          <time datetime={isoDate(data.updatedDate)}>{formatDate(locale, data.updatedDate)}</time>
        </span>
      )}
    </p>
    <TagList locale={locale} tags={data.tags} class="mt-md" />
  </header>
  <div class="prose mt-xl">
    <slot />
  </div>
</article>
