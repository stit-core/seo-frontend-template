---
import { type Locale, t } from '@/shared/i18n'
import { tagPath } from '../lib/paths'

interface Props {
  locale: Locale
  tags: readonly string[]
  class?: string | undefined
}

const { locale, tags, class: className } = Astro.props
---

{tags.length > 0 && (
  <ul
    class:list={['flex flex-wrap gap-x-sm gap-y-2xs text-helper', className]}
    aria-label={t(locale, 'blog.tags')}
  >
    {tags.map((tag) => (
      <li>
        <a class="touch-target" href={tagPath(locale, tag)} rel="tag">
          #{tag}
        </a>
      </li>
    ))}
  </ul>
)}
