---
import { type Locale, t } from '@/shared/i18n'

interface Props {
  locale: Locale
  // Те же строки, что уходят в разметку Person: подпись и JSON-LD не расходятся.
  name: string
  jobTitle?: string | undefined
}

const { locale, name, jobTitle } = Astro.props
const signature = jobTitle === undefined ? name : `${name}, ${jobTitle}`
---

<p class="mt-md text-helper text-secondary">
  {t(locale, 'author.by')} <span class="text-primary">{signature}</span>
</p>
