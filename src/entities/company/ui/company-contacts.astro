---
import { type Locale, t } from '@/shared/i18n'
import { Term, TermList } from '@/shared/ui/term-list'
import { COMPANY } from '../model/company'

interface Props {
  locale: Locale
  class?: string | undefined
}

const { locale, class: className } = Astro.props
const address = COMPANY.address[locale]
---

<TermList class={className}>
  <Term name={t(locale, 'company.email')}>
    <a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a>
  </Term>
  <Term name={t(locale, 'company.phone')}>
    <a href={`tel:${COMPANY.phoneHref}`}>{COMPANY.phone}</a>
  </Term>
  <Term name={t(locale, 'company.address')}>
    <address class="not-italic">
      {address.postalCode}, {address.locality}, {address.street}
    </address>
  </Term>
  <Term name={t(locale, 'company.hours')}>{COMPANY.hours[locale]}</Term>
</TermList>
