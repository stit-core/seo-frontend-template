---
import type { CssVariable } from 'astro:assets'
// Компонент — файлом, а не из astro:assets: модуль astro:assets тянет конвейер картинок (getImage, обёртку
// sharp), а оболочку рендерят и on-demand страницы — их серверный бандл нёс бы его зря.
import Font from 'astro/components/Font.astro'
import '@/app/styles/index.css'
import Metrika from '@/app/analytics/metrika.astro'
import { fontFamilies } from '@/app/styles/fonts'
import { PreferencesInit } from '@/features/preferences'
import { ISLANDS, standsOn, THEME } from '@/shared/config'
import { type Locale, localePath, routeOf, type Translations, t } from '@/shared/i18n'
import { type JsonLd, JsonLdScript, type OgImage, SeoHead } from '@/shared/seo'
import { pageLink } from '@/shared/strategy'
import { SiteFooter } from '@/widgets/site-footer'
import { SiteHeader } from '@/widgets/site-header'

interface Props {
  locale: Locale
  // Заголовок без имени сайта (шаблон добавит суффикс) и уникальный description страницы.
  title: string
  description: string
  // Карта переводов страницы: локаль → адрес версии (своя — тоже). Из неё — hreflang и переводы в переключателе
  // языка.
  translations?: Translations | undefined
  // Служебная страница (404, /now, подтверждение заявки) и тонкая (тег ниже порога записей):
  // noindex, без canonical, OG и hreflang.
  noindex?: boolean | undefined
  ogType?: 'website' | 'article'
  ogImage?: OgImage | undefined
  article?: { published: Date; modified?: Date | undefined } | undefined
  // JSON-LD страницы в <head>: Organization/WebSite главной, BreadcrumbList вложенной, BlogPosting записи.
  jsonLd?: readonly JsonLd[]
}

const {
  locale,
  title,
  description,
  translations,
  noindex,
  ogType,
  ogImage,
  article,
  jsonLd = [],
} = Astro.props
// Тема без выбора — системная: её включает блок prefers-color-scheme файла токенов; заданную
// полем THEME ставит атрибут ДС. Своего color-scheme у оболочки нет — его объявляет файл токенов.
const theme = THEME.default === 'system' ? undefined : THEME.default
// Острова оболочки — по строкам реестра: предпочтения с кнопкой темы — на всём сайте, без неё — на
// страницах с переключателем движения; счётчик — при заданном идентификаторе.
const route = routeOf(Astro.url.pathname)
// Фид блога — у языка, где есть свой блог: фид другого языка в автообнаружении не нужен.
const blog = pageLink('/blog', locale)
const feed =
  blog !== undefined && blog.hreflang === undefined ? localePath(locale, '/rss.xml') : undefined
// Шрифты ДС — `<Font>` каждого семейства списка: `@font-face` и переменная семейства, на которую
// ссылаются роли файла токенов; preload — начертания первого экрана. Тип CssVariable Astro выводит
// из конфига, а конфиг — из того же списка.
const fonts = fontFamilies().map(({ variable, preload }) => ({
  cssVariable: variable as CssVariable,
  preload: preload.length > 0 && preload,
}))
// Порядок иконок: первой — PNG 192×192. Какую из нескольких иконок возьмёт выдача Google, его
// справка не говорит, поэтому первой стоит та, что ему подходит: растр (SVG в списке его форматов
// нет) крупнее рекомендованных 48 px — ICO 32×32 мельче.
---

<!doctype html>
<html lang={locale} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {fonts.map(({ cssVariable, preload }) => (
      <Font cssVariable={cssVariable} preload={preload} />
    ))}
    <SeoHead
      title={title}
      description={description}
      locale={locale}
      translations={translations}
      feed={feed}
      noindex={noindex}
      ogType={ogType}
      ogImage={ogImage}
      article={article}
    />
    {jsonLd.map((data) => (
      <JsonLdScript data={data} />
    ))}
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {standsOn(ISLANDS.preferences, route) && <PreferencesInit />}
    {standsOn(ISLANDS.metrika, route) && <Metrika />}
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-md focus:left-md focus:z-10 focus:rounded-control focus:bg-accent-solid focus:px-md focus:py-xs focus:text-on-accent"
    >
      {t(locale, 'nav.skip')}
    </a>
    <SiteHeader locale={locale} translations={translations} />
    {/* Ширину, фон и ритм странице дают её секции (shared/ui/section): оболочка её не сужает. */}
    <main id="main" class="flex-1">
      <slot />
    </main>
    <SiteFooter locale={locale} />
  </body>
</html>
