---
import type { CssVariable } from 'astro:assets'
// Компонент — файлом, а не из astro:assets: модуль astro:assets тянет конвейер картинок (getImage, обёртку
// sharp), а оболочку рендерят и on-demand страницы — их серверный бандл нёс бы его зря.
import Font from 'astro/components/Font.astro'
import '@/app/styles/index.css'
import ConsentBanner from '@/app/analytics/consent-banner.astro'
import Metrika from '@/app/analytics/metrika.astro'
import { fontFamilies } from '@/app/styles/fonts'
import { PreferencesInit } from '@/features/preferences'
import { ISLANDS, METRIKA_ID, standsOn, THEME } from '@/shared/config'
import { type Locale, localePath, routeOf, type Translations, t } from '@/shared/i18n'
import {
  breadcrumbList,
  type JsonLd,
  JsonLdScript,
  type OgImage,
  type PageMeta,
  SeoHead,
} from '@/shared/seo'
import { type BlockProps, fail, pageLink, type StrategyPage } from '@/shared/strategy'
import { Container } from '@/shared/ui/section'
import { Breadcrumbs, type breadcrumbs } from '@/widgets/breadcrumbs'
import { Footer, footer } from '@/widgets/footer'
import { Header, header } from '@/widgets/header'

interface Props {
  locale: Locale
  // Мета страницы — copy deck как есть (у записи коллекции — её поля): заголовок с брендом, описание и тексты превью
  // ссылки; title и description уникальны среди страниц сборки.
  meta: PageMeta
  // Карта переводов страницы: локаль → адрес версии (своя — тоже). Из неё — hreflang и переводы в переключателе
  // языка.
  translations?: Translations | undefined
  // Служебная страница (404, подтверждение заявки, ответ формы) и тонкая (тег ниже порога записей):
  // noindex, без canonical, OG и hreflang.
  noindex?: boolean | undefined
  ogImage?: OgImage | undefined
  // Даты записи коллекции: страница записи — статья (og:type article и article:*).
  article?: { published: Date; modified?: Date | undefined } | undefined
  // JSON-LD страницы в <head> — узлы типов её плана (`seo.structured_data`); BreadcrumbList оболочка ставит из крошек.
  jsonLd?: readonly JsonLd[]
  // Каркас — шапка и подвал: секции плана этой страницы strategy; у страницы без своего плана — главной, она задаёт
  // общие шапку и подвал сайта. Своего умолчания у оболочки нет: на запросе она читала бы план главной.
  chrome: StrategyPage
  // Крошки страницы шаблона карты с крошками (с глубины 2): видимые и BreadcrumbList в <head> — из этого пропа.
  crumbs?: BlockProps<typeof breadcrumbs> | undefined
}

const {
  locale,
  meta,
  translations,
  noindex,
  ogImage,
  article,
  jsonLd = [],
  chrome,
  crumbs,
} = Astro.props
const sectionOf = (block: string) => chrome.sections.find((section) => section.block === block)?.id
const top = sectionOf(header.id)
const bottom = sectionOf(footer.id)
const trail = crumbs && [
  ...crumbs.crumb.map((step) => ({ name: step.label, href: step.link.href })),
  { name: crumbs.current },
]
const blocks = trail ? [...jsonLd, breadcrumbList(trail)] : jsonLd
// Тема без выбора — системная: её включает блок prefers-color-scheme файла токенов; заданную
// полем THEME ставит атрибут ДС. Своего color-scheme у оболочки нет — его объявляет файл токенов.
const theme = THEME.default === 'system' ? undefined : THEME.default
// Острова оболочки — по строкам реестра: предпочтения — на каждой странице, когда сайт даёт выбор (кнопка
// темы или переключатель движения); счётчик — при заданном идентификаторе и только со своим баннером согласия.
const route = routeOf(Astro.url.pathname)
const counter = standsOn(ISLANDS.metrika, route)
const policy = counter
  ? (chrome.policy ??
    fail(`${chrome.id}/legal/privacy_policy`, 'у счётчика нет политики ПДн для баннера'))
  : undefined
// Фид блога — у языка, где есть свой блог: фид другого языка в автообнаружении не нужен.
const blog = pageLink('/blog', locale)
const feed =
  blog !== undefined && blog.hreflang === undefined ? localePath(locale, '/rss.xml') : undefined
// Шрифты ДС — `<Font>` каждого семейства списка: `@font-face` и переменная семейства, на которую
// ссылаются роли файла токенов; preload — начертания первого экрана. Тип CssVariable Astro выводит
// из конфига, а конфиг — из того же списка.
const fonts = fontFamilies().map(({ variable, preload }) => ({
  cssVariable: variable as CssVariable,
  preload: preload.length > 0 && preload,
}))
// Порядок иконок: первой — PNG 192×192. Какую из нескольких иконок возьмёт выдача Google, его
// справка не говорит, поэтому первой стоит та, что ему подходит: растр (SVG в списке его форматов
// нет) крупнее рекомендованных 48 px — ICO 32×32 мельче.
---

<!doctype html>
<html lang={locale} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {fonts.map(({ cssVariable, preload }) => (
      <Font cssVariable={cssVariable} preload={preload} />
    ))}
    <SeoHead
      meta={meta}
      locale={locale}
      translations={translations}
      feed={feed}
      noindex={noindex}
      ogImage={ogImage}
      article={article}
    />
    {blocks.map((data) => (
      <JsonLdScript data={data} />
    ))}
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {standsOn(ISLANDS.preferences, route) && <PreferencesInit />}
    {counter && <Metrika counter={METRIKA_ID} />}
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-md focus:left-md focus:z-10 focus:rounded-control focus:bg-accent-solid focus:px-md focus:py-xs focus:text-on-accent"
    >
      {t(locale, 'nav.skip')}
    </a>
    {/* Баннер согласия — до шапки, но после перехода к содержимому: переход — первая ссылка страницы, иначе axe не
    признаёт его переходом и считает содержимым вне лендмарков. */}
    {policy && <ConsentBanner locale={locale} policy={policy} />}
    {top && <Header {...header.props(chrome, top)} locale={locale} translations={translations} />}
    {/* Крошки — каркас, а не секция страницы: на контейнере шапки, перед <main>. */}
    {crumbs && (
      <Container width="page" class="pt-md">
        <Breadcrumbs {...crumbs} locale={locale} />
      </Container>
    )}
    {/* Ширину, фон и ритм странице дают её секции (shared/ui/section): оболочка её не сужает. */}
    <main id="main" class="flex-1">
      <slot />
    </main>
    {bottom && <Footer {...footer.props(chrome, bottom)} locale={locale} />}
  </body>
</html>
