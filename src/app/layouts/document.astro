---
import '@/app/styles/index.css'
import Metrika from '@/app/analytics/metrika.astro'
import { ThemeInit } from '@/features/theme'
import { type Locale, t } from '@/shared/i18n'
import { type JsonLd, JsonLdScript, type OgImage, SeoHead } from '@/shared/seo'
import { SiteFooter } from '@/widgets/site-footer'
import { SiteHeader } from '@/widgets/site-header'

interface Props {
  locale: Locale
  // Заголовок без имени сайта (шаблон добавит суффикс) и уникальный description страницы.
  title: string
  description: string
  // Путь перевода без префикса локали; без него нет ни ссылки на другую локаль в шапке, ни hreflang.
  alternatePath?: string | undefined
  // Служебная страница (404, /now, подтверждение заявки) и тонкая (тег ниже порога записей):
  // noindex, без canonical, OG и hreflang.
  noindex?: boolean | undefined
  ogType?: 'website' | 'article'
  ogImage?: OgImage | undefined
  article?: { published: Date; modified?: Date | undefined } | undefined
  // JSON-LD страницы в <head>: Organization/WebSite главной, BreadcrumbList вложенной, BlogPosting записи.
  jsonLd?: readonly JsonLd[]
}

const {
  locale,
  title,
  description,
  alternatePath,
  noindex,
  ogType,
  ogImage,
  article,
  jsonLd = [],
} = Astro.props
// Порядок иконок: первой — PNG 192×192. Иконку сайта для выдачи Google берёт из первого
// <link rel="icon"> с подходящим форматом: SVG он не читает, а ICO 32×32 мельче его 48 px.
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead
      title={title}
      description={description}
      locale={locale}
      alternatePath={alternatePath}
      noindex={noindex}
      ogType={ogType}
      ogImage={ogImage}
      article={article}
    />
    {jsonLd.map((data) => (
      <JsonLdScript data={data} />
    ))}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <ThemeInit />
    <Metrika />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-10 focus:rounded-control focus:bg-action-bg focus:px-4 focus:py-2 focus:text-action-fg"
    >
      {t(locale, 'nav.skip')}
    </a>
    <SiteHeader locale={locale} alternatePath={alternatePath} />
    <main id="main" class="mx-auto w-full max-w-content flex-1 px-6 py-12">
      <slot />
    </main>
    <SiteFooter locale={locale} />
  </body>
</html>
