---
interface Props {
  counter: string
}

const { counter } = Astro.props

// Остров согласия со счётчиком (rule shared-ui § 0 JS по умолчанию): счётчик — только после «Принять» в своём баннере;
// идентификатор — атрибутом, чтобы тело и его хеш в строке `metrika` реестра ISLANDS были одни на любой счётчик.
---

<script is:inline data-island="metrika" data-counter={counter}>
  {
    const d = document
    const counterId = d.currentScript.dataset.counter
    const YEAR = 31536e6
    let choice = ''
    const read = () => {
      try {
        const [value, at] = (localStorage.getItem('consent') ?? '').split(' ')
        choice = /^(accept|reject)$/.test(value) && Date.now() - at < YEAR ? value : ''
      } catch {
        choice = ''
      }
    }
    const load = () => {
      if (window.ym) return
      window.ym = (...args) => {
        window.ym.a = window.ym.a || []
        window.ym.a.push(args)
      }
      window.ym.l = Date.now()
      const script = d.createElement('script')
      script.async = true
      script.src = 'https://mc.yandex.ru/metrika/tag.js'
      d.head.append(script)
      window.ym(counterId, 'init')
    }
    const start = () => {
      if (choice !== 'accept') return
      if ('requestIdleCallback' in window) requestIdleCallback(load, { timeout: 5000 })
      else setTimeout(load, 2000)
    }
    const show = () => {
      for (const banner of d.querySelectorAll('[data-consent-banner]'))
        banner.hidden = choice !== ''
    }
    const tick = () => {
      show()
      if (d.readyState === 'loading') requestAnimationFrame(tick)
    }
    read()
    start()
    tick()
    d.addEventListener('readystatechange', show)
    addEventListener('pageshow', (event) => {
      if (!event.persisted) return
      read()
      show()
      start()
    })
    d.addEventListener('click', (event) => {
      const value = event.target.closest?.('[data-consent]')?.dataset.consent
      if (value !== 'accept' && value !== 'reject') return
      try {
        localStorage.setItem('consent', `${value} ${Date.now()}`)
        read()
      } catch {
        choice = value
      }
      show()
      start()
    })
  }
</script>
