---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro'
import { tagPaths } from '../../../_blog/static-paths'
import TagPage from '../../../_blog/tag-page.astro'

export const getStaticPaths = (() => tagPaths()) satisfies GetStaticPaths

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { locale, tag, posts } = Astro.props
---

<TagPage locale={locale} tag={tag} posts={posts} />
