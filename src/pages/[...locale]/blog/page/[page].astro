---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro'
import BlogListPage from '../../../_blog/blog-list-page.astro'
import { pagePaths } from '../../../_blog/static-paths'

export const getStaticPaths = (() => pagePaths()) satisfies GetStaticPaths

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { locale, page } = Astro.props
---

<BlogListPage locale={locale} page={page} />
