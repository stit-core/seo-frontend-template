---
import DocumentLayout from '@/app/layouts/document.astro'
import { blogPath, listPosts } from '@/entities/post'
import { type Locale, localePath, t } from '@/shared/i18n'
import { organization, webSite } from '@/shared/seo'
import { Heading } from '@/shared/ui/heading'
import { Section } from '@/shared/ui/section'
import { PostList } from '@/widgets/post-list'

const locale: Locale = 'ru'
const latest = (await listPosts(locale)).slice(0, 3)

const facts = [
  {
    term: 'Рендер',
    text: 'Prerender по умолчанию: HTML собран на сборке. On-demand — только там, где ответ зависит от запроса.',
  },
  {
    term: 'JavaScript',
    text: 'Ноль на контентных страницах и в записях. Единственный островок — переключатель темы: инлайн, без загрузки.',
  },
  {
    term: 'Поиск',
    text: 'Canonical, hreflang, OG и JSON-LD в первом HTML; карта сайта, фиды и robots.txt — на живом origin.',
  },
  {
    term: 'Развёртывание',
    text: 'Один Docker-образ на все среды: канонический адрес сайта штампуется при старте контейнера.',
  },
  {
    term: 'Архитектура',
    text: 'Feature-Sliced Design под линтером: границы слоёв держит ESLint, структуру — Steiger, гейт — pnpm check.',
  },
  {
    term: 'Контент',
    text: 'Markdown в git рядом с кодом: схема frontmatter, бюджеты сниппета и проверка ссылок — до сборки.',
  },
]
---

<DocumentLayout
  locale={locale}
  alternatePath="/"
  title="Шаблон индексируемого сайта"
  description="Static-first шаблон сайта на Astro 7: prerender по умолчанию, ноль JavaScript на контентных страницах, один Docker-образ на все среды."
  jsonLd={[organization(), webSite()]}
>
  <Section rhythm="m" labelledby="page-title">
    <Heading id="page-title" level={1} kind="display">
      Шаблон индексируемого сайта
    </Heading>
    <p class="mt-stack-display text-lead text-secondary">
      Страницы собираются заранее и отдаются Node-процессом как файлы. Серверный рендер включается
      там, где без запроса не обойтись: редиректы, robots.txt, форма.
    </p>
    <p class="mt-xl flex flex-wrap items-center gap-x-lg gap-y-sm">
      <a class="button" href={blogPath(locale)}>
        {t(locale, 'blog.all')}
      </a>
      <a class="touch-target" href={localePath(locale, '/contacts')}>
        {t(locale, 'nav.contacts')}
      </a>
    </p>
  </Section>

  <Section width="wide" tone="subtle" rhythm="m" labelledby="inside">
    <Heading id="inside" level={2}>
      Что внутри
    </Heading>
    <dl class="mt-lg grid gap-x-xl gap-y-lg tablet:grid-cols-2 desktop:grid-cols-3">
      {facts.map((fact) => (
        <div>
          <dt class="text-body-strong">{fact.term}</dt>
          <dd class="mt-2xs text-secondary">{fact.text}</dd>
        </div>
      ))}
    </dl>
  </Section>

  <Section rhythm="m" labelledby="latest">
    <Heading id="latest" level={2}>
      {t(locale, 'blog.latest')}
    </Heading>
    <div class="mt-lg">
      <PostList locale={locale} posts={latest} />
    </div>
    <p class="mt-xl">
      <a class="touch-target" href={blogPath(locale)}>
        {t(locale, 'blog.all')}
      </a>
    </p>
  </Section>

  <Section rhythm="m" label="О шаблоне">
    <p class="note">
      Это стартовая страница шаблона: замените текст и записи своими. Команды, структура репозитория
      и путь потребителя описаны в README.
    </p>
  </Section>
</DocumentLayout>
