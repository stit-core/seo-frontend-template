---
// On-demand: путь без статического файла тогда доходит до app/middleware (удалённые адреса
// redirects.yaml, X-Request-Id, лог); prerendered 404.html адаптер отдал бы с диска до него.
export const prerender = false

import files from 'virtual:strategy/not-found'
import DocumentLayout from '@/app/layouts/document.astro'
import { localeOf } from '@/shared/i18n'
import { pageOf } from '@/shared/strategy'
import { NotFound, notFound } from '@/widgets/not-found'

// Язык страницы — по префиксу запрошенного пути: под `/en/…` человек читал английскую версию.
const locale = localeOf(Astro.url.pathname)
const page = pageOf(files, locale)
---

<DocumentLayout
  locale={locale}
  title={page.meta.title}
  description={page.meta.description}
  chrome={page}
  noindex
>
  <NotFound {...notFound.props(page, 'not-found')} />
</DocumentLayout>
