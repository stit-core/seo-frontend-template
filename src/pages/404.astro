---
// On-demand: путь без статического файла тогда доходит до app/middleware (удалённые адреса
// redirects.yaml, X-Request-Id, лог); prerendered 404.html адаптер отдал бы с диска до него.
export const prerender = false

import DocumentLayout from '@/app/layouts/document.astro'
import { localeOf, localePath, t } from '@/shared/i18n'

// Язык страницы — по префиксу запрошенного пути: под `/en/…` человек читал английскую версию.
const locale = localeOf(Astro.url.pathname)
---

<DocumentLayout
  locale={locale}
  title={t(locale, 'notFound.title')}
  description={t(locale, 'notFound.lead')}
  noindex
>
  <h1 class="text-heading-xl font-semibold tracking-tight">{t(locale, 'notFound.title')}</h1>
  <p class="mt-4 text-body-lg text-secondary">{t(locale, 'notFound.lead')}</p>
  <p class="mt-8 text-body-md">
    <a href={localePath(locale, '/')}>{t(locale, 'notFound.home')}</a>
  </p>
</DocumentLayout>
