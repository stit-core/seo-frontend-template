---
// On-demand: путь без статического файла тогда доходит до app/middleware (удалённые адреса
// redirects.yaml, X-Request-Id, лог); prerendered 404.html адаптер отдал бы с диска до него.
export const prerender = false

import DocumentLayout from '@/app/layouts/document.astro'
import { localeOf, localePath, t } from '@/shared/i18n'
import { Heading } from '@/shared/ui/heading'
import { Section } from '@/shared/ui/section'

// Язык страницы — по префиксу запрошенного пути: под `/en/…` человек читал английскую версию.
const locale = localeOf(Astro.url.pathname)
---

<DocumentLayout
  locale={locale}
  title={t(locale, 'notFound.title')}
  description={t(locale, 'notFound.lead')}
  noindex
>
  <Section labelledby="page-title">
    <Heading id="page-title" level={1}>
      {t(locale, 'notFound.title')}
    </Heading>
    <p class="mt-stack-display text-lead text-secondary">{t(locale, 'notFound.lead')}</p>
    <p class="mt-xl text-body">
      <a class="touch-target" href={localePath(locale, '/')}>
        {t(locale, 'notFound.home')}
      </a>
    </p>
  </Section>
</DocumentLayout>
