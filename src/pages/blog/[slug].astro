---
import type { GetStaticPaths } from 'astro'
import type { Post } from '@/entities/post'
import PostPage from '../_blog/post-page.astro'
import { postPaths } from '../_blog/static-paths'

export const getStaticPaths = (() => postPaths('ru')) satisfies GetStaticPaths

interface Props {
  post: Post
}

const { post } = Astro.props
---

<PostPage post={post} />
