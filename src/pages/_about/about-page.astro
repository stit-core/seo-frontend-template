---
import about from 'virtual:strategy/about'
import DocumentLayout from '@/app/layouts/document.astro'
import type { Locale } from '@/shared/i18n'
import { aboutPage } from '@/shared/seo'
import { pageOf, pageVersions } from '@/shared/strategy'
import { ContactDetails, contactDetails } from '@/widgets/contact-details'
import { HeroText, heroText } from '@/widgets/hero-text'
import { Prose, prose } from '@/widgets/prose'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const page = pageOf(about, locale)
---

<DocumentLayout
  locale={locale}
  chrome={page}
  translations={pageVersions(page.id)}
  meta={page.meta}
  jsonLd={[aboutPage({ locale, path: page.url, name: page.meta.title })]}
>
  <HeroText {...heroText.props(page, 'hero')} />
  <Prose {...prose.props(page, 'about')} />
  <ContactDetails {...contactDetails.props(page, 'contacts')} locale={locale} />
</DocumentLayout>
