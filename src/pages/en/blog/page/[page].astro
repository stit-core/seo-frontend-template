---
import type { GetStaticPaths } from 'astro'
import type { Page, Post } from '@/entities/post'
import type { Locale } from '@/shared/i18n'
import BlogListPage from '../../../_blog/blog-list-page.astro'
import { pagePaths } from '../../../_blog/static-paths'

export const getStaticPaths = (() => pagePaths('en')) satisfies GetStaticPaths

interface Props {
  locale: Locale
  page: Page<Post>
}

const { locale, page } = Astro.props
---

<BlogListPage locale={locale} page={page} />
