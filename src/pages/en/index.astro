---
import DocumentLayout from '@/app/layouts/document.astro'
import { blogPath, listPosts } from '@/entities/post'
import { type Locale, localePath, t } from '@/shared/i18n'
import { organization } from '@/shared/seo'
import { PostList } from '@/widgets/post-list'

const locale: Locale = 'en'
const latest = (await listPosts(locale)).slice(0, 3)

// WebSite печатает только корень домена (/): оттуда Google читает имя сайта.
const facts = [
  {
    term: 'Rendering',
    text: 'Prerendered by default: the HTML is built once. On-demand rendering only where the answer depends on the request.',
  },
  {
    term: 'JavaScript',
    text: 'None on content pages. The single island is the theme switch: inline, with nothing to download.',
  },
  {
    term: 'Search',
    text: 'Canonical, hreflang, OG and JSON-LD in the first HTML; sitemap, feeds and robots.txt on the live origin.',
  },
  {
    term: 'Deployment',
    text: 'One Docker image for every environment: the canonical site address is stamped in at container start.',
  },
  {
    term: 'Architecture',
    text: 'Feature-Sliced Design under lint: ESLint guards the layer boundaries, Steiger the structure, pnpm check the rest.',
  },
]
---

<DocumentLayout
  locale={locale}
  alternatePath="/"
  title="Indexable site template"
  description="Static-first site template on Astro 7: prerendered by default, zero JavaScript on content pages, one Docker image for every environment."
  jsonLd={[organization()]}
>
  <h1 class="text-page-title tablet:text-page-title-lg">Indexable site template</h1>
  <p class="mt-stack-display text-lead text-secondary">
    Pages are built ahead of time and served by the Node process as files. Server rendering turns on
    where a request is unavoidable: redirects, robots.txt, the contact form.
  </p>
  <p class="mt-xl flex flex-wrap items-center gap-x-lg gap-y-sm">
    <a class="button" href={blogPath(locale)}>
      {t(locale, 'blog.all')}
    </a>
    <a href={localePath(locale, '/contacts')}>{t(locale, 'nav.contacts')}</a>
  </p>

  <h2 class="section-title mt-section-m text-section">What is inside</h2>
  <dl class="mt-lg grid gap-x-xl gap-y-md text-body tablet:grid-cols-terms">
    {facts.map((fact) => (
      <Fragment>
        <dt class="text-body-strong text-primary">{fact.term}</dt>
        <dd class="text-secondary">{fact.text}</dd>
      </Fragment>
    ))}
  </dl>

  <h2 class="section-title mt-section-m text-section">{t(locale, 'blog.latest')}</h2>
  <div class="mt-lg">
    <PostList locale={locale} posts={latest} />
  </div>
  <p class="mt-xl">
    <a href={blogPath(locale)}>{t(locale, 'blog.all')}</a>
  </p>

  <p class="note mt-section-m">
    This is the template's starting page: replace the text and the notes with your own. Commands,
    repository layout and the consumer path are described in the README.
  </p>
</DocumentLayout>
