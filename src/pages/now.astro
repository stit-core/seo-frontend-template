---
// Режим dynamic: время сервера меняется на каждый запрос, поэтому страница рендерится
// on-demand и не кешируется.
export const prerender = false

import DocumentLayout from '@/app/layouts/document.astro'
import { DEFAULT_LOCALE, formatDateTime } from '@/shared/i18n'
import { Heading } from '@/shared/ui/heading'
import { Section } from '@/shared/ui/section'

const locale = DEFAULT_LOCALE
const now = new Date()

// Роут важнее middleware: живой ответ — не для общих кешей и не для «спроси сервер».
Astro.response.headers.set('cache-control', 'private, no-store')
---

<DocumentLayout
  locale={locale}
  title="Время сервера"
  description="Служебная on-demand страница: время сервера на момент запроса."
  noindex
>
  <Section labelledby="page-title">
    <Heading id="page-title" level={1}>
      Время сервера
    </Heading>
    <p class="mt-stack-display text-lead">
      <time datetime={now.toISOString()}>{formatDateTime(locale, now)}</time>
    </p>
    <p class="mt-xs text-helper text-secondary">
      ISO 8601: <code>{now.toISOString()}</code>
    </p>
  </Section>

  <Section labelledby="on-demand">
    <Heading id="on-demand" level={2}>
      Что такое on-demand в этом шаблоне
    </Heading>
    <p class="mt-md text-body">
      Почти все страницы собираются один раз на сборке и отдаются Node-процессом как файлы. Эта —
      исключение: у неё стоит <code>export const prerender = false</code>, и она рендерится на
      каждый запрос, поэтому время выше — свежее. Так же устроены только служебные маршруты:
      проверка живости процесса, страница 404, robots.txt, файл ключа IndexNow, обработчик формы.
    </p>
    <p class="mt-md text-body">
      Ответ уходит с <code>Cache-Control: private, no-store</code> и <code>noindex</code>: живая
      страница не для общих кешей и не для поиска.
    </p>
  </Section>
</DocumentLayout>
