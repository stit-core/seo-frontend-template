---
// Режим dynamic: время сервера меняется на каждый запрос, поэтому страница рендерится
// on-demand и не кешируется. Единственная такая HTML-страница reference-набора.
export const prerender = false

import DocumentLayout from '@/app/layouts/document.astro'
import { formatDateTime } from '@/shared/i18n'

const locale = 'ru' as const
const now = new Date()

// Роут важнее middleware: живой ответ — не для общих кешей и не для «спроси сервер».
Astro.response.headers.set('cache-control', 'private, no-store')
---

<DocumentLayout
  locale={locale}
  title="Время сервера"
  description="Служебная on-demand страница: время сервера на момент запроса."
  noindex
>
  <h1 class="text-page-title">Время сервера</h1>
  <p class="mt-stack-display text-lead">
    <time datetime={now.toISOString()}>{formatDateTime(locale, now)}</time>
  </p>
  <p class="mt-xs text-helper text-secondary">
    ISO 8601: <code>{now.toISOString()}</code>
  </p>

  <h2 class="mt-2xl text-section">Что такое on-demand в этом шаблоне</h2>
  <p class="mt-md text-body">
    Почти все страницы собираются один раз на сборке и отдаются Node-процессом как файлы. Эта —
    исключение: у неё стоит <code>export const prerender = false</code>, и она рендерится на каждый
    запрос, поэтому время выше — свежее. Так же устроены только служебные маршруты: проверка живости
    процесса, страница 404, robots.txt, карта сайта, фиды, обработчик формы.
  </p>
  <p class="mt-md text-body">
    Ответ уходит с <code>Cache-Control: private, no-store</code> и <code>noindex</code>: живая
    страница не для общих кешей и не для поиска. JavaScript здесь, как и на остальных страницах,
    нет.
  </p>
</DocumentLayout>
