---
import contacts from 'virtual:strategy/contacts'
import DocumentLayout from '@/app/layouts/document.astro'
import type { ContactErrors, ContactValues } from '@/features/contact-form'
import { type DictKey, type Locale, t } from '@/shared/i18n'
import { contactPage, localBusiness } from '@/shared/seo'
import { fail, pageOf, pageVersions } from '@/shared/strategy'
import { ContactDetails, contactDetails } from '@/widgets/contact-details'
import { HeroText, heroText } from '@/widgets/hero-text'
import { LeadForm, leadForm } from '@/widgets/lead-form'

interface Props {
  locale: Locale
  // Заполненные поля и ошибки приходят с ответа обработчика формы; на самой странице их нет.
  values?: ContactValues | undefined
  errors?: ContactErrors | undefined
  notice?: DictKey | undefined
  // Ответ обработчика персональный (в полях — присланное) и служебный: только noindex.
  noindex?: boolean | undefined
}

const { locale, values, errors, notice, noindex } = Astro.props
const page = pageOf(contacts, locale)
// Ответ с ошибками называет отказ первым словом заголовка окна: вкладка и чтец экрана сообщают о
// нём раньше текста страницы.
const failed = errors !== undefined || notice !== undefined
const meta = failed
  ? { ...page.meta, title: t(locale, 'form.failed', { title: page.meta.title }) }
  : page.meta
// Согласие на обработку ПДн ссылается на политику — её версию по карте; без политики форму не собрать.
const policy =
  page.policy ?? fail(`${page.id}/legal/privacy_policy`, 'у страницы с формой нет политики ПДн')
---

<DocumentLayout
  locale={locale}
  chrome={page}
  meta={meta}
  translations={pageVersions(page.id)}
  noindex={noindex}
  jsonLd={[contactPage({ locale, path: page.url, name: page.meta.title }), localBusiness(page)]}
>
  <HeroText {...heroText.props(page, 'hero')} />
  <LeadForm
    {...leadForm.props(page, 'lead-form')}
    locale={locale}
    action="/api/contact"
    policy={policy}
    values={values}
    errors={errors}
    notice={notice}
  />
  <ContactDetails {...contactDetails.props(page, 'contacts')} locale={locale} />
</DocumentLayout>
