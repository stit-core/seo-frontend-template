---
import thanks from 'virtual:strategy/thank-you'
import DocumentLayout from '@/app/layouts/document.astro'
import type { Locale } from '@/shared/i18n'
import { pageOf, pageVersions } from '@/shared/strategy'
import { ContactDetails, contactDetails } from '@/widgets/contact-details'
import { ThankYou, thankYou } from '@/widgets/thank-you'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const page = pageOf(thanks, locale)
---

<DocumentLayout
  locale={locale}
  chrome={page}
  translations={pageVersions('thank-you')}
  title={page.meta.title}
  description={page.meta.description}
  noindex
>
  <ThankYou {...thankYou.props(page, 'confirmation')} />
  <ContactDetails {...contactDetails.props(page, 'contacts')} locale={locale} />
</DocumentLayout>
