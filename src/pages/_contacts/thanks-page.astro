---
import DocumentLayout from '@/app/layouts/document.astro'
import { CompanyContacts } from '@/entities/company'
import { type Locale, localePath, t } from '@/shared/i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<DocumentLayout
  locale={locale}
  title={t(locale, 'thanks.title')}
  description={t(locale, 'thanks.lead')}
  noindex
>
  <h1 class="text-heading-xl font-semibold tracking-tight">{t(locale, 'thanks.title')}</h1>
  <p class="mt-4 text-body-lg text-muted">{t(locale, 'thanks.lead')}</p>
  <p class="mt-8">
    <a class="button" href={localePath(locale, '/contacts')}>
      {t(locale, 'thanks.back')}
    </a>
  </p>
  <CompanyContacts locale={locale} class="mt-12 border-t border-divider pt-8" />
</DocumentLayout>
