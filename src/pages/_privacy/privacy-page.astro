---
import privacy from 'virtual:strategy/privacy'
import DocumentLayout from '@/app/layouts/document.astro'
import type { Locale } from '@/shared/i18n'
import { pageOf, pageVersions } from '@/shared/strategy'
import { LegalText, legalText } from '@/widgets/legal-text'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const page = pageOf(privacy, locale)
---

<DocumentLayout
  locale={locale}
  chrome={page}
  translations={pageVersions('privacy')}
  title={page.meta.title}
  description={page.meta.description}
>
  <LegalText {...legalText.props(page, 'legal')} />
</DocumentLayout>
