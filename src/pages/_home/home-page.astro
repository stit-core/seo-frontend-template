---
import home from 'virtual:strategy/home'
import DocumentLayout from '@/app/layouts/document.astro'
import { listPosts, postPath } from '@/entities/post'
import type { Locale } from '@/shared/i18n'
import { organization, webSite } from '@/shared/seo'
import { pageOf, pageVersions } from '@/shared/strategy'
import { ArticleCards, articleCards } from '@/widgets/article-cards'
import { FeatureGrid, featureGrid } from '@/widgets/feature-grid'
import { HeroText, heroText } from '@/widgets/hero-text'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const page = pageOf(home, locale)
// Свежие записи кладёт страница из коллекции: план их не заполняет.
const latest = (await listPosts(locale)).slice(0, 3).map((post) => ({
  title: post.data.title,
  date: post.data.pubDate,
  link: { href: postPath(locale, post.slug) },
  excerpt: post.data.description,
}))
// WebSite печатает только корень домена (/): оттуда Google читает имя сайта.
const jsonLd = Astro.url.pathname === '/' ? [organization(), webSite()] : [organization()]
---

<DocumentLayout
  locale={locale}
  chrome={page}
  translations={pageVersions('home')}
  title={page.meta.title}
  description={page.meta.description}
  jsonLd={jsonLd}
>
  <HeroText {...heroText.props(page, 'hero')} />
  <FeatureGrid {...featureGrid.props(page, 'benefits')} />
  <ArticleCards {...articleCards.props(page, 'related')} article={latest} locale={locale} />
</DocumentLayout>
