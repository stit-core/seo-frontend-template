---
import home from 'virtual:strategy/home'
import DocumentLayout from '@/app/layouts/document.astro'
import type { Post } from '@/entities/post'
import type { Locale } from '@/shared/i18n'
import { pageOf } from '@/shared/strategy'
import { Heading } from '@/shared/ui/heading'
import { Section } from '@/shared/ui/section'
import { tagPageModel } from './models'
import PostList from './post-list.astro'

interface Props {
  locale: Locale
  tag: string
  posts: readonly Post[]
}

const { locale, tag, posts } = Astro.props
const model = await tagPageModel(locale, tag)
---

<DocumentLayout
  locale={locale}
  chrome={pageOf(home, locale)}
  noindex={model.noindex}
  translations={model.translations}
  title={model.title}
  description={model.description}
  crumbs={model.crumbs}
>
  <Section labelledby="page-title">
    <Heading id="page-title" level={1}>
      {model.heading}
    </Heading>
    <div class="mt-2xl">
      <PostList locale={locale} posts={posts} />
    </div>
  </Section>
</DocumentLayout>
