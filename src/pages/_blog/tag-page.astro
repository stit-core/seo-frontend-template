---
import files from 'virtual:strategy/tag'
import DocumentLayout from '@/app/layouts/document.astro'
import { type Post, postCard } from '@/entities/post'
import type { Locale } from '@/shared/i18n'
import { templateOf } from '@/shared/strategy'
import { ArticleCards, articleCards } from '@/widgets/article-cards'
import { breadcrumbs } from '@/widgets/breadcrumbs'
import { HeroText, heroText } from '@/widgets/hero-text'
import { tagPageModel } from './models'

interface Props {
  locale: Locale
  tag: string
  posts: readonly Post[]
}

const { locale, tag, posts } = Astro.props
const page = templateOf(files, locale)
const model = await tagPageModel(locale, tag)
---

<DocumentLayout
  locale={locale}
  chrome={page}
  noindex={model.noindex}
  translations={model.translations}
  title={model.title}
  description={model.description}
  crumbs={breadcrumbs.props(page, 'breadcrumbs', { current: model.current })}
>
  <HeroText
    {...heroText.props(page, 'hero', { headline: model.title, subheadline: model.description })}
  />
  <ArticleCards
    {...articleCards.props(page, 'related', { article: posts.map(postCard) })}
    locale={locale}
  />
</DocumentLayout>
