---
import DocumentLayout from '@/app/layouts/document.astro'
import type { Post } from '@/entities/post'
import type { Locale } from '@/shared/i18n'
import { Heading } from '@/shared/ui/heading'
import { Section } from '@/shared/ui/section'
import { Breadcrumbs } from '@/widgets/breadcrumbs'
import { PostList } from '@/widgets/post-list'
import { tagPageModel } from './sections'

interface Props {
  locale: Locale
  tag: string
  posts: readonly Post[]
}

const { locale, tag, posts } = Astro.props
const model = await tagPageModel(locale, tag)
---

<DocumentLayout
  locale={locale}
  noindex={model.noindex}
  alternatePath={model.alternatePath}
  title={model.title}
  description={model.description}
  jsonLd={model.jsonLd}
>
  <Section labelledby="page-title">
    <Breadcrumbs locale={locale} items={model.crumbs} class="mb-md" />
    <Heading id="page-title" level={1}>
      {model.heading}
    </Heading>
    <div class="mt-2xl">
      <PostList locale={locale} posts={posts} />
    </div>
  </Section>
</DocumentLayout>
