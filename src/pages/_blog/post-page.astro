---
import home from 'virtual:strategy/home'
import DocumentLayout from '@/app/layouts/document.astro'
import { AuthorByline } from '@/entities/author'
import { type Post, PostArticle, renderPost } from '@/entities/post'
import { pageOf } from '@/shared/strategy'
import { Section } from '@/shared/ui/section'
import { postPageModel } from './models'

interface Props {
  post: Post
}

const { post } = Astro.props
const { locale, data } = post
const { Content } = await renderPost(post)
const model = await postPageModel(post)
---

<DocumentLayout
  locale={locale}
  chrome={pageOf(home, locale)}
  translations={model.translations}
  title={data.title}
  description={data.description}
  ogType="article"
  ogImage={model.ogImage}
  article={model.article}
  jsonLd={model.jsonLd}
  crumbs={model.crumbs}
>
  <Section labelledby="page-title">
    <PostArticle post={post} titleId="page-title">
      {model.author && (
        <AuthorByline
          slot="byline"
          locale={locale}
          name={model.author.name}
          jobTitle={model.author.jobTitle}
        />
      )}
      <Content />
    </PostArticle>
  </Section>
</DocumentLayout>
