---
import DocumentLayout from '@/app/layouts/document.astro'
import { AuthorByline } from '@/entities/author'
import { type Post, PostArticle, renderPost } from '@/entities/post'
import { Breadcrumbs } from '@/widgets/breadcrumbs'
import { postPageModel } from './sections'

interface Props {
  post: Post
}

const { post } = Astro.props
const { locale, data } = post
const { Content } = await renderPost(post)
const model = await postPageModel(post)
---

<DocumentLayout
  locale={locale}
  alternatePath={model.alternatePath}
  title={data.title}
  description={data.description}
  ogType="article"
  ogImage={model.ogImage}
  article={model.article}
  jsonLd={model.jsonLd}
>
  <Breadcrumbs locale={locale} items={model.crumbs} class="mb-md" />
  <PostArticle post={post}>
    {model.author && (
      <AuthorByline
        slot="byline"
        locale={locale}
        name={model.author.name}
        jobTitle={model.author.jobTitle}
      />
    )}
    <Content />
  </PostArticle>
</DocumentLayout>
