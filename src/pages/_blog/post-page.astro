---
import files from 'virtual:strategy/post'
import DocumentLayout from '@/app/layouts/document.astro'
import { type Post, renderPost } from '@/entities/post'
import { templateOf } from '@/shared/strategy'
import { ArticleBody, articleBody } from '@/widgets/article-body'
import { breadcrumbs } from '@/widgets/breadcrumbs'
import { RelatedLinks, relatedLinks } from '@/widgets/related-links'
import { postPageModel } from './models'

interface Props {
  post: Post
}

const { post } = Astro.props
const { locale, data } = post
const page = templateOf(files, locale)
const { Content } = await renderPost(post)
const model = await postPageModel(post)
---

<DocumentLayout
  locale={locale}
  chrome={page}
  translations={model.translations}
  meta={{ title: data.title, description: data.description }}
  ogImage={model.ogImage}
  article={model.article}
  jsonLd={model.jsonLd}
  crumbs={breadcrumbs.props(page, 'breadcrumbs', { current: data.title })}
>
  <ArticleBody
    {...articleBody.props(page, 'article-body', model.record)}
    locale={locale}
    tags={model.tags}
  >
    <Content />
  </ArticleBody>
  {model.related.length > 0 && (
    <RelatedLinks {...relatedLinks.props(page, 'related', { item: model.related })} />
  )}
</DocumentLayout>
