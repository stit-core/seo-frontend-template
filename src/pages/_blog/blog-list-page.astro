---
import files from 'virtual:strategy/blog'
import DocumentLayout from '@/app/layouts/document.astro'
import type { Page, Post } from '@/entities/post'
import type { Locale } from '@/shared/i18n'
import { pageOf } from '@/shared/strategy'
import { ArticleCards, articleCards } from '@/widgets/article-cards'
import { HeroText, heroText } from '@/widgets/hero-text'
import { blogListPageModel } from './models'

interface Props {
  locale: Locale
  page: Page<Post>
}

const { locale, page: list } = Astro.props
const page = pageOf(files, locale)
const model = await blogListPageModel(locale, list)
const hero = heroText.props(page, 'hero')
---

<DocumentLayout
  locale={locale}
  chrome={page}
  translations={model.translations}
  title={model.paged(page.meta.title)}
  description={model.paged(page.meta.description)}
>
  <HeroText {...hero} headline={model.paged(hero.headline)} />
  <ArticleCards
    {...articleCards.props(page, 'related', { article: model.articles })}
    locale={locale}
    pagination={model.pagination}
  />
</DocumentLayout>
