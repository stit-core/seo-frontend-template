---
import home from 'virtual:strategy/home'
import DocumentLayout from '@/app/layouts/document.astro'
import { type Page, type Post, TagList } from '@/entities/post'
import { type Locale, t } from '@/shared/i18n'
import { pageOf } from '@/shared/strategy'
import { Heading } from '@/shared/ui/heading'
import { Section } from '@/shared/ui/section'
import { blogListPageModel } from './models'
import PostList from './post-list.astro'

interface Props {
  locale: Locale
  page: Page<Post>
}

const { locale, page } = Astro.props
const model = await blogListPageModel(locale, page)
---

<DocumentLayout
  locale={locale}
  chrome={pageOf(home, locale)}
  translations={model.translations}
  title={model.title}
  description={model.description}
>
  <Section labelledby="page-title">
    <Heading id="page-title" level={1}>
      {model.heading}
    </Heading>
    <p class="mt-stack-display text-lead text-secondary">{t(locale, 'blog.lead')}</p>
    <TagList locale={locale} tags={model.tags} class="mt-lg" />
    <div class="mt-2xl">
      <PostList locale={locale} posts={page.items} pagination={model.pagination} />
    </div>
  </Section>
</DocumentLayout>
