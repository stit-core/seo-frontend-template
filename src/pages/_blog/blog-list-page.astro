---
import DocumentLayout from '@/app/layouts/document.astro'
import { type Page, type Post, TagList } from '@/entities/post'
import { type Locale, t } from '@/shared/i18n'
import { Breadcrumbs } from '@/widgets/breadcrumbs'
import { PostList } from '@/widgets/post-list'
import { blogListPageModel } from './sections'

interface Props {
  locale: Locale
  page: Page<Post>
}

const { locale, page } = Astro.props
const model = await blogListPageModel(locale, page)
---

<DocumentLayout
  locale={locale}
  alternatePath={model.alternatePath}
  title={model.title}
  description={model.description}
  jsonLd={model.jsonLd}
>
  <Breadcrumbs locale={locale} items={model.crumbs} class="mb-4" />
  <h1 class="text-heading-xl font-semibold tracking-tight">{model.heading}</h1>
  <p class="mt-4 text-body-lg text-muted">{t(locale, 'blog.lead')}</p>
  <TagList locale={locale} tags={model.tags} class="mt-6" />
  <div class="mt-10">
    <PostList locale={locale} posts={page.items} pagination={model.pagination} />
  </div>
</DocumentLayout>
