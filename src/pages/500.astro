---
// Страницу с диска отдаёт адаптер, когда рендер on-demand маршрута бросил исключение:
// поэтому она собирается заранее и не зависит ни от запроса, ни от данных — язык у неё один,
// дефолтный: файл запроса не знает.

import home from 'virtual:strategy/home'
import DocumentLayout from '@/app/layouts/document.astro'
import { DEFAULT_LOCALE, localePath, t } from '@/shared/i18n'
import { pageOf } from '@/shared/strategy'
import { Heading } from '@/shared/ui/heading'
import { Section } from '@/shared/ui/section'

const locale = DEFAULT_LOCALE
---

<DocumentLayout
  locale={locale}
  chrome={pageOf(home, locale)}
  title={t(locale, 'error.title')}
  description={t(locale, 'error.lead')}
  noindex
>
  <Section labelledby="page-title">
    <Heading id="page-title" level={1}>
      {t(locale, 'error.title')}
    </Heading>
    <p class="mt-stack-display text-lead text-secondary">{t(locale, 'error.lead')}</p>
    <p class="mt-xl">
      <a class="button" href={localePath(locale, '/')}>
        {t(locale, 'notFound.home')}
      </a>
    </p>
  </Section>
</DocumentLayout>
