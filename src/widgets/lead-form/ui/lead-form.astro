---
import { Form, type FormAnswer } from '@/features/lead-form'
import type { Locale } from '@/shared/i18n'
import { channelText } from '@/shared/lib'
import type { BlockProps, Policy } from '@/shared/strategy'
import { Heading } from '@/shared/ui/heading'
import { Section } from '@/shared/ui/section'
import type { leadForm } from '../model/block'

type Props = BlockProps<typeof leadForm> & {
  locale: Locale
  // Маршрут обработчика и политику ПДн согласия (версия по карте, заголовок и редакция) знает страница.
  action: string
  policy: Policy
  // Ответ обработчика формы: присланное и отказы; на самой странице его нет.
  answer?: FormAnswer | undefined
}

const {
  id,
  title,
  lead,
  form,
  'cta-label': submitLabel,
  consent,
  'next-steps': nextSteps,
  messenger,
  locale,
  action,
  policy,
  answer,
} = Astro.props
---

<Section labelledby={id}>
  <Heading id={id} level={2}>
    {title}
  </Heading>
  <p class="mt-md text-lead text-secondary">{lead}</p>
  <div class="mt-lg">
    <Form
      id={id}
      locale={locale}
      action={action}
      form={form}
      policy={policy}
      submitLabel={submitLabel}
      consentLabel={consent}
      answer={answer}
    />
  </div>
  <p class="mt-lg text-helper text-secondary">{nextSteps}</p>
  {/* Канал того же действия без подписи в анатомии показывает свой адрес. */}
  {messenger && (
    <p class="mt-md">
      <a class="touch-target" href={messenger.href}>
        {channelText(messenger.href)}
      </a>
    </p>
  )}
</Section>
