---
import { SITE_NAME } from '@/shared/config'
import { DEFAULT_LOCALE, type Locale, localePath, t } from '@/shared/i18n'
import { pageLink } from '@/shared/strategy'
import { Container } from '@/shared/ui/section'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
// На prerendered-страницах это год сборки — год релиза, что и означает строка копирайта.
const year = new Date().getFullYear()
// Контакты и фид — разделы версии: без своей версии на языке страницы их в подвале нет. Политика обработки ПДн —
// документ оператора: без перевода ссылка ведёт на версию основного языка и называет её язык.
const own = (route: string) => {
  const link = pageLink(route, locale)
  return link?.hreflang === undefined ? link?.href : undefined
}
const contacts = own('/contacts')
const feed = own('/blog') === undefined ? undefined : localePath(locale, '/rss.xml')
const privacy = pageLink('/legal/privacy', locale)
// Время сервера — служебная страница на дефолтном языке.
const nowLang = locale === DEFAULT_LOCALE ? undefined : DEFAULT_LOCALE
---

<footer class="border-t border-subtle">
  <Container
    width="page"
    class="flex flex-col gap-lg py-xl text-helper text-secondary tablet:flex-row tablet:items-baseline tablet:justify-between"
  >
    <p>
      © {year} {SITE_NAME}
      <br />
      {t(locale, 'footer.note')}
    </p>
    <nav aria-label={t(locale, 'footer.links')}>
      <ul class="flex flex-wrap gap-x-lg gap-y-xs tablet:justify-end">
        {contacts !== undefined && (
          <li>
            <a class="touch-target text-secondary no-underline hover:underline" href={contacts}>
              {t(locale, 'nav.contacts')}
            </a>
          </li>
        )}
        {privacy !== undefined && (
          <li>
            <a
              class="touch-target text-secondary no-underline hover:underline"
              href={privacy.href}
              hreflang={privacy.hreflang}
            >
              {t(locale, 'footer.privacy')}
            </a>
          </li>
        )}
        {feed !== undefined && (
          <li>
            <a class="touch-target text-secondary no-underline hover:underline" href={feed}>
              {t(locale, 'footer.rss')}
            </a>
          </li>
        )}
        <li>
          <a
            class="touch-target text-secondary no-underline hover:underline"
            href="/now"
            hreflang={nowLang}
          >
            {t(locale, 'footer.now')}
          </a>
        </li>
      </ul>
    </nav>
  </Container>
</footer>
