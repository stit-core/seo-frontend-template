---
import { SITE_NAME } from '@/shared/config'
import { DEFAULT_LOCALE, type Locale, t } from '@/shared/i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
// На prerendered-страницах это год сборки — год релиза, что и означает строка копирайта.
const year = new Date().getFullYear()
---

<footer class="border-t border-divider">
  <div class="mx-auto flex max-w-content flex-wrap items-center justify-between gap-x-6 gap-y-2 px-6 py-6 text-body-sm text-muted">
    <p>
      © {year} {SITE_NAME} · {t(locale, 'footer.note')}
    </p>
    <a
      href="/now"
      hreflang={locale === DEFAULT_LOCALE ? undefined : DEFAULT_LOCALE}
      class="text-muted"
    >
      {t(locale, 'footer.now')}
    </a>
  </div>
</footer>
