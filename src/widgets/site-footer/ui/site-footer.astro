---
import { SITE_NAME } from '@/shared/config'
import { DEFAULT_LOCALE, type Locale, localePath, t } from '@/shared/i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
// На prerendered-страницах это год сборки — год релиза, что и означает строка копирайта.
const year = new Date().getFullYear()
const foreignLocale = locale === DEFAULT_LOCALE ? undefined : DEFAULT_LOCALE
---

<footer class="mt-20 border-t border-subtle">
  <div class="mx-auto flex max-w-page flex-col gap-6 px-6 py-8 text-body-sm text-secondary sm:flex-row sm:items-start sm:justify-between">
    <p>
      © {year} {SITE_NAME}
      <br />
      {t(locale, 'footer.note')}
    </p>
    <nav aria-label={t(locale, 'footer.links')}>
      <ul class="flex flex-wrap gap-x-5 gap-y-2 sm:justify-end">
        <li>
          <a
            class="text-secondary no-underline hover:underline"
            href={localePath(locale, '/contacts')}
          >
            {t(locale, 'nav.contacts')}
          </a>
        </li>
        <li>
          {/* Политика обработки ПДн опубликована по-русски: это документ российского оператора. */}
          <a
            class="text-secondary no-underline hover:underline"
            href="/legal/privacy"
            hreflang={foreignLocale}
          >
            {t(locale, 'footer.privacy')}
          </a>
        </li>
        <li>
          <a
            class="text-secondary no-underline hover:underline"
            href={localePath(locale, '/rss.xml')}
          >
            {t(locale, 'footer.rss')}
          </a>
        </li>
        <li>
          <a
            class="text-secondary no-underline hover:underline"
            href="/now"
            hreflang={foreignLocale}
          >
            {t(locale, 'footer.now')}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</footer>
