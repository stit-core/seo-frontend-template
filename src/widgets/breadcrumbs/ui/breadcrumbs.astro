---
import { type Locale, t } from '@/shared/i18n'
import type { BlockProps } from '@/shared/strategy'
import type { breadcrumbs } from '../model/block'

// Те же пропсы оболочка отдаёт в BreadcrumbList — JSON-LD в <head>.
type Props = BlockProps<typeof breadcrumbs> & { locale: Locale }

const { crumb, current, locale } = Astro.props
// Путь от главной; последняя ступень — текущая страница, без ссылки.
const steps = [...crumb, { label: current, link: undefined }]
---

<nav aria-label={t(locale, 'nav.breadcrumbs')} class="text-helper text-secondary">
  <ol class="flex flex-wrap items-center gap-x-xs">
    {steps.map((step, index) => (
      <li class="flex items-center gap-x-xs">
        {index > 0 && <span aria-hidden="true">›</span>}
        {step.link ? (
          <a class="touch-target" href={step.link.href} hreflang={step.link.hreflang}>
            {step.label}
          </a>
        ) : (
          <span aria-current="page">{step.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
