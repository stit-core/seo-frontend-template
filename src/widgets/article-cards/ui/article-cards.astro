---
import { formatDate, isoDate, type Locale, t } from '@/shared/i18n'
import type { BlockProps } from '@/shared/strategy'
import { ActionLink } from '@/shared/ui/action'
import { Heading } from '@/shared/ui/heading'
import { Section } from '@/shared/ui/section'
import type { articleCards } from '../model/block'

// Страницы списка — навигация хаба коллекции (пагинация карты), а не элемент анатомии: номер, последняя и соседние.
type Props = BlockProps<typeof articleCards> & {
  locale: Locale
  pagination?:
    | { current: number; last: number; newer: string | undefined; older: string | undefined }
    | undefined
}

const {
  id,
  title,
  all,
  'all-label': allLabel,
  article: articles = [],
  locale,
  pagination,
} = Astro.props
---

<Section labelledby={id}>
  <Heading id={id} level={2}>
    {title}
  </Heading>
  {articles.length === 0 ? (
    <p class="mt-lg text-body text-secondary">{t(locale, 'blog.empty')}</p>
  ) : (
    <ul class="mt-lg flex flex-col gap-xl">
      {articles.map((article) => (
        <li>
          <article class="border-b border-subtle pb-xl">
            <Heading level={3}>
              <a
                href={article.link.href}
                hreflang={article.link.hreflang}
                class="touch-target text-primary no-underline hover:text-accent"
              >
                {article.title}
              </a>
            </Heading>
            <p class="mt-xs text-helper text-secondary">
              <time datetime={isoDate(article.date)}>{formatDate(locale, article.date)}</time>
            </p>
            {article.excerpt && <p class="mt-sm text-body">{article.excerpt}</p>}
          </article>
        </li>
      ))}
    </ul>
  )}
  {all && allLabel && (
    <p class="mt-xl">
      <ActionLink href={all.href} hreflang={all.hreflang} label={allLabel} kind="secondary" />
    </p>
  )}
  {pagination && pagination.last > 1 && (
    <nav
      aria-label={t(locale, 'blog.pagination')}
      class="mt-2xl flex items-center justify-between gap-lg text-helper"
    >
      <span>
        {pagination.newer && (
          <a class="touch-target" href={pagination.newer} rel="prev">
            ← {t(locale, 'blog.newer')}
          </a>
        )}
      </span>
      <span class="text-secondary">
        {pagination.current} / {pagination.last}
      </span>
      <span>
        {pagination.older && (
          <a class="touch-target" href={pagination.older} rel="next">
            {t(locale, 'blog.older')} →
          </a>
        )}
      </span>
    </nav>
  )}
</Section>
