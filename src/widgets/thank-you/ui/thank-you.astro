---
import type { BlockProps } from '@/shared/strategy'
import { ActionLink } from '@/shared/ui/action'
import { Heading } from '@/shared/ui/heading'
import { Section } from '@/shared/ui/section'
import type { thankYou } from '../model/block'

type Props = BlockProps<typeof thankYou>

const {
  id,
  title,
  'next-steps': nextSteps,
  secondary,
  'secondary-label': secondaryLabel,
} = Astro.props
---

<Section labelledby={id}>
  <Heading id={id} level={1}>
    {title}
  </Heading>
  <p class="mt-stack-display text-lead text-secondary">{nextSteps}</p>
  {secondary && secondaryLabel && (
    <p class="mt-xl">
      <ActionLink
        href={secondary.href}
        hreflang={secondary.hreflang}
        label={secondaryLabel}
        kind="secondary"
      />
    </p>
  )}
</Section>
