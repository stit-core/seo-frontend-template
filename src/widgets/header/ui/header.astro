---
import { ThemeToggle } from '@/features/preferences'
import { SITE_NAME, THEME } from '@/shared/config'
import { type Locale, localeInfo, localePath, type Translations, t } from '@/shared/i18n'
import { type BlockProps, languageLinks, menuLinks } from '@/shared/strategy'
import { ActionLink } from '@/shared/ui/action'
import { Container } from '@/shared/ui/section'
import type { header } from '../model/block'

type Props = BlockProps<typeof header> & {
  locale: Locale
  // Карта переводов страницы: переключатель языка ведёт на её версии.
  translations?: Translations | undefined
}

const {
  id,
  variant,
  'nav-link': labels = [],
  cta,
  'cta-label': ctaLabel,
  phone,
  'lang-switch': switcher,
  locale,
  translations = {},
} = Astro.props

// Путь страницы: на prerendered это её собственный маршрут, на on-demand — запрошенный.
const path = Astro.url.pathname
// Меню сайта — у шапки сайта; у посадочной (landing-minimal) меню нет: логотип, призыв и контакт.
const site = variant === 'site-nav'
const menu = site ? menuLinks(labels, locale, `${id}/nav-link`) : []
const isCurrent = (href: string): boolean => path === href || path.startsWith(`${href}/`)
const languages = switcher === undefined ? [] : languageLinks(locale, translations)
// Ряд шапки с меню — лендмарк навигации, без меню — просто ряд действий.
const Bar = site ? 'nav' : 'div'
---

<header class="border-b border-subtle">
  <Container
    width="page"
    class="flex flex-wrap items-center justify-between gap-x-xl gap-y-sm py-md"
  >
    {/* Знак сайта — имя бренда ссылкой на главную языка: файл знака — манифест пакета дизайна. */}
    <a
      href={localePath(locale, '/')}
      class="touch-target text-body-strong text-primary no-underline hover:text-accent"
    >
      {SITE_NAME}
    </a>
    <Bar aria-label={site ? t(locale, 'nav.label') : undefined} class="w-full tablet:w-auto">
      {/* На узком экране ряд занимает вторую строку целиком и расходится по краям. */}
      <ul class="flex flex-wrap items-center justify-between gap-x-md gap-y-xs text-helper tablet:justify-end tablet:gap-x-lg">
        {menu.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class:list={[
                'touch-target no-underline hover:text-primary',
                isCurrent(item.href)
                  ? 'text-primary underline decoration-accent decoration-thick underline-offset-marker'
                  : 'text-secondary',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
        {languages.map((language) => (
          <li>
            <a
              href={language.href}
              hreflang={language.locale}
              lang={language.locale}
              rel={language.translation ? 'alternate' : undefined}
              class="touch-target text-secondary no-underline hover:text-primary"
            >
              {localeInfo(language.locale).name}
            </a>
          </li>
        ))}
        {THEME.switcher && (
          <li class="flex items-center">
            <ThemeToggle locale={locale} />
          </li>
        )}
        {phone && (
          <li>
            <a href={phone.href} class="touch-target text-primary no-underline hover:text-accent">
              {phone.href.replace(/^tel:/, '')}
            </a>
          </li>
        )}
        {cta && ctaLabel && (
          <li>
            <ActionLink href={cta.href} hreflang={cta.hreflang} label={ctaLabel} kind="primary" />
          </li>
        )}
      </ul>
    </Bar>
  </Container>
</header>
