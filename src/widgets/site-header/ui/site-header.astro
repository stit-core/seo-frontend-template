---
import { ThemeToggle } from '@/features/preferences'
import { SITE_NAME, THEME } from '@/shared/config'
import {
  type DictKey,
  type Locale,
  localeInfo,
  localePath,
  type Translations,
  t,
} from '@/shared/i18n'
import { languageLinks, pageLink } from '@/shared/strategy'
import { Container } from '@/shared/ui/section'

interface Props {
  locale: Locale
  translations?: Translations | undefined
}

const { locale, translations = {} } = Astro.props

// Путь страницы: на prerendered это её собственный маршрут, на on-demand — запрошенный.
const path = Astro.url.pathname
// Меню версии — только её разделы: страницы без версии на языке страницы в нём нет.
const items = (
  [
    { route: '/blog', key: 'nav.blog' },
    { route: '/about', key: 'nav.about' },
    { route: '/contacts', key: 'nav.contacts' },
  ] satisfies Array<{ route: string; key: DictKey }>
).flatMap(({ route, key }) => {
  const link = pageLink(route, locale)
  return link === undefined || link.hreflang !== undefined ? [] : [{ href: link.href, key }]
})
const isCurrent = (href: string): boolean => path === href || path.startsWith(`${href}/`)
const languages = languageLinks(locale, translations)
---

<header class="border-b border-subtle">
  <Container
    width="page"
    class="flex flex-wrap items-center justify-between gap-x-xl gap-y-sm py-md"
  >
    <a
      href={localePath(locale, '/')}
      class="touch-target text-body-strong text-primary no-underline hover:text-accent"
    >
      {SITE_NAME}
    </a>
    <nav aria-label={t(locale, 'nav.label')} class="w-full tablet:w-auto">
      {/* На узком экране навигация занимает вторую строку целиком и расходится по краям. */}
      <ul class="flex flex-wrap items-center justify-between gap-x-md gap-y-xs text-helper tablet:justify-end tablet:gap-x-lg">
        {items.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class:list={[
                'touch-target no-underline hover:text-primary',
                isCurrent(item.href)
                  ? 'text-primary underline decoration-accent decoration-thick underline-offset-marker'
                  : 'text-secondary',
              ]}
            >
              {t(locale, item.key)}
            </a>
          </li>
        ))}
        {languages.map((language) => (
          <li>
            <a
              href={language.href}
              hreflang={language.locale}
              lang={language.locale}
              rel={language.translation ? 'alternate' : undefined}
              class="touch-target text-secondary no-underline hover:text-primary"
            >
              {localeInfo(language.locale).name}
            </a>
          </li>
        ))}
        {THEME.switcher && (
          <li class="flex items-center">
            <ThemeToggle locale={locale} />
          </li>
        )}
      </ul>
    </nav>
  </Container>
</header>
