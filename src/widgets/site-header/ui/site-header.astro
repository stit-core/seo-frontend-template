---
import { ThemeToggle } from '@/features/theme'
import { SITE_NAME, THEME } from '@/shared/config'
import { type DictKey, type Locale, localePath, SUPPORTED_LOCALES, t } from '@/shared/i18n'
import { Container } from '@/shared/ui/section'

interface Props {
  locale: Locale
  alternatePath?: string | undefined
}

const { locale, alternatePath } = Astro.props
const other = SUPPORTED_LOCALES.find((candidate) => candidate !== locale)

// Путь страницы: на prerendered это её собственный маршрут, на on-demand — запрошенный.
const path = Astro.url.pathname
const items: Array<{ route: string; key: DictKey }> = [
  { route: '/blog', key: 'nav.blog' },
  { route: '/about', key: 'nav.about' },
  { route: '/contacts', key: 'nav.contacts' },
]
const isCurrent = (route: string): boolean => {
  const href = localePath(locale, route)
  return path === href || path.startsWith(`${href}/`)
}
---

<header class="border-b border-subtle">
  <Container
    width="page"
    class="flex flex-wrap items-center justify-between gap-x-xl gap-y-sm py-md"
  >
    <a
      href={localePath(locale, '/')}
      class="touch-target text-body-strong text-primary no-underline hover:text-accent"
    >
      {SITE_NAME}
    </a>
    <nav aria-label={t(locale, 'nav.label')} class="w-full tablet:w-auto">
      {/* На узком экране навигация занимает вторую строку целиком и расходится по краям. */}
      <ul class="flex flex-wrap items-center justify-between gap-x-md gap-y-xs text-helper tablet:justify-end tablet:gap-x-lg">
        {items.map((item) => (
          <li>
            <a
              href={localePath(locale, item.route)}
              aria-current={isCurrent(item.route) ? 'page' : undefined}
              class:list={[
                'touch-target no-underline hover:text-primary',
                isCurrent(item.route)
                  ? 'text-primary underline decoration-accent decoration-thick underline-offset-marker'
                  : 'text-secondary',
              ]}
            >
              {t(locale, item.key)}
            </a>
          </li>
        ))}
        {other !== undefined && alternatePath !== undefined && (
          <li>
            <a
              href={localePath(other, alternatePath)}
              hreflang={other}
              lang={other}
              rel="alternate"
              class="touch-target text-secondary no-underline hover:text-primary"
            >
              {t(other, 'lang.name')}
            </a>
          </li>
        )}
        {THEME.switcher && (
          <li class="flex items-center">
            <ThemeToggle locale={locale} />
          </li>
        )}
      </ul>
    </nav>
  </Container>
</header>
