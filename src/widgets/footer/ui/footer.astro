---
import { type Locale, t } from '@/shared/i18n'
import { bindNumbers } from '@/shared/lib'
import { type BlockProps, labelled } from '@/shared/strategy'
import { Container } from '@/shared/ui/section'
import type { footer } from '../model/block'

type Props = BlockProps<typeof footer> & { locale: Locale }

const { id, legal, privacy, 'privacy-label': privacyLabels, email, nav = [], locale } = Astro.props

// Правовые документы оператора: без версии на языке страницы ссылка ведёт на версию другого языка и называет его.
const documents = labelled(privacy, privacyLabels, `${id}/privacy`)
// Разделы — те, что даёт секция плана, в любом варианте (у minimal каталог их не снимает): версии языка страницы, без
// своей версии раздела в подвале нет.
const sections = nav.filter((item) => item.link.hreflang === undefined)
---

<footer class="border-t border-subtle">
  <Container
    width="page"
    class="flex flex-col gap-lg py-xl text-helper text-secondary tablet:flex-row tablet:items-baseline tablet:justify-between"
  >
    <div class="flex flex-col gap-xs">
      <p>{bindNumbers(legal)}</p>
      {email && (
        <address class="not-italic">
          <a class="touch-target text-secondary no-underline hover:underline" href={email.href}>
            {email.href.replace(/^mailto:/, '')}
          </a>
        </address>
      )}
    </div>
    <nav aria-label={t(locale, 'footer.links')}>
      <ul class="flex flex-wrap gap-x-lg gap-y-xs tablet:justify-end">
        {sections.map((item) => (
          <li>
            <a
              class="touch-target text-secondary no-underline hover:underline"
              href={item.link.href}
            >
              {item.label}
            </a>
          </li>
        ))}
        {documents.map((document) => (
          <li>
            <a
              class="touch-target text-secondary no-underline hover:underline"
              href={document.href}
              hreflang={document.hreflang}
            >
              {document.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </Container>
</footer>
