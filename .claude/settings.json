{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(pnpm publish*)",
      "Bash(npm publish*)",
      "Bash(*--no-verify*)",
      "Bash(*--no-gpg-sign*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout -- *)",
      "Bash(git clean -f*)",
      "Bash(rm -rf /*)",
      "Write(**/.claude/projects/**/memory/**)",
      "Edit(**/.claude/projects/**/memory/**)",
      "MultiEdit(**/.claude/projects/**/memory/**)"
    ]
  }
}
